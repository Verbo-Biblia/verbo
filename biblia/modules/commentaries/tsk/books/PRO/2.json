{"entries":[{"id":"tsk-pro-2-1","title":"Proverbs 2:1","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":1,"chapterEnd":2,"verseEnd":1},"content":"<p>1 Wisdom promises godliness to her children; 10 and safety from evil company; 20 and direction in good ways.</p>\n<p>if. 1:3; 4:1; 7:1; Joh 12:47,48; 1Ti 1:15 hide. 3:1; 4:20-22; 6:21; De 6:6-9; Job 23:12; Ps 119:9-11; Mt 13:44 Lu 2:19,51; 9:44</p>"},{"id":"tsk-pro-2-2","title":"Proverbs 2:2","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":2,"chapterEnd":2,"verseEnd":2},"content":"<p>thou. 18:1; Ps 119:111,112; Isa 55:3; Mt 13:9 apply. 22:17-21; 23:12; Ps 90:12; Ec 7:25; 8:9,16; Ac 17:11</p>"},{"id":"tsk-pro-2-3","title":"Proverbs 2:3","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":3,"chapterEnd":2,"verseEnd":3},"content":"<p>if. 3:6; 8:17; 1Ki 3:9-12; 1Ch 22:12; Ps 25:4,5; 119:34,73,125,169 Lu 11:13; Eph 1:17,18; Jas 1:5 liftest up thy voice. Heb. givest thy voice.</p>"},{"id":"tsk-pro-2-4","title":"Proverbs 2:4","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":4,"chapterEnd":2,"verseEnd":4},"content":"<p>thou. 3:14,15; 8:18,19; 16:16; 23:23; Ps 19:10; 119:14,72,127; Mt 6:19-21 Mt 13:44; 19:21,22,29 searchest. Job 28:12-20; Ec 4:8; Lu 16:8</p>"},{"id":"tsk-pro-2-5","title":"Proverbs 2:5","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":5,"chapterEnd":2,"verseEnd":5},"content":"<p>shalt. 2Ch 1:10-12; Ho 6:3; Mt 7:7,8; Lu 11:9-13 the fear. 9:10; Job 28:28; Jer 32:40,41 find. Jer 9:24; 24:7; 31:34; Mt 11:27; Lu 10:22; Joh 17:3; 1Jo 5:20</p>"},{"id":"tsk-pro-2-6","title":"Proverbs 2:6","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":6,"chapterEnd":2,"verseEnd":6},"content":"<p>the Lord. Ex 31:3; 1Ki 3:9,12; 4:29; 1Ch 22:12; Job 32:8; Isa 54:13; Da 1:17 Da 2:21,23; Lu 21:15; Joh 6:45; Eph 1:17,18; Jas 1:5,17 out. 6:23; 8:5-9; Ps 19:7; 119:98,104; Isa 8:20</p>"},{"id":"tsk-pro-2-7","title":"Proverbs 2:7","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":7,"chapterEnd":2,"verseEnd":7},"content":"<p>layeth. 8:14; 14:8; Job 28:8; 1Co 1:19,24,30; 2:6,7; 3:18,19; Col 2:3 2Ti 3:15-17; Jas 3:15-17 a buckler. 28:18; 30:5; Ps 84:11; 144:2</p>"},{"id":"tsk-pro-2-8","title":"Proverbs 2:8","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":8,"chapterEnd":2,"verseEnd":8},"content":"<p>keepeth. 8:20; Ps 1:6; 23:3; 121:5-8; Isa 35:9; 49:9,10; Joh 10:28,29 and. 3:21-24; De 33:3,26-29; 1Sa 2:9; Ps 37:23,24,28,31; 66:9; 145:20 Jer 32:40,41; 1Pe 1:5; Jude 1:24</p>"},{"id":"tsk-pro-2-9","title":"Proverbs 2:9","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":9,"chapterEnd":2,"verseEnd":9},"content":"<p>1:2-6; Ps 25:8,9; 32:8; 119:99,105; 143:8-10; Isa 35:8; 48:17 Jer 6:16; Mt 7:13,14; Joh 14:6</p>"},{"id":"tsk-pro-2-10","title":"Proverbs 2:10","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":10,"chapterEnd":2,"verseEnd":10},"content":"<p>18:1,2; 24:13,14; Job 23:12; Ps 19:10; 104:34; 119:97,103,111,162 Jer 15:16; Col 3:16</p>"},{"id":"tsk-pro-2-11","title":"Proverbs 2:11","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":11,"chapterEnd":2,"verseEnd":11},"content":"<p>4:6; 6:22-24; Ps 25:21; 119:9-11; Ec 9:15-18; 10:10; Eph 5:15</p>"},{"id":"tsk-pro-2-12","title":"Proverbs 2:12","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":12,"chapterEnd":2,"verseEnd":12},"content":"<p>deliver. 1:10-19; 4:14-17; 9:6; 13:20; Ps 17:4,5; 26:4,5; 141:4; 2Co 6:17 from the man. 3:32; 8:13; 16:28-30; Ps 101:4; Isa 59:3-5; Ac 20:30; 1Co 15:33</p>"},{"id":"tsk-pro-2-13","title":"Proverbs 2:13","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":13,"chapterEnd":2,"verseEnd":13},"content":"<p>leave. 21:16; Ps 14:3; 36:3; Eze 18:26; 33:12,13; Zep 1:6; Mt 12:43-45 2Ti 4:10; Heb 6:4-6; 2Pe 2:20-22; 1Jo 2:19 walk. 4:19; Job 24:13-16; Joh 3:19,20; 12:35; Ro 1:21; 1Th 5:5-7 Joh 1:6; 2:9-11</p>"},{"id":"tsk-pro-2-14","title":"Proverbs 2:14","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":14,"chapterEnd":2,"verseEnd":14},"content":"<p>rejoice. 10:23; Jer 11:15; Hab 1:15; Zep 3:11; 1Co 13:6 and. Ho 7:3; Lu 22:4,5; Ro 1:32</p>"},{"id":"tsk-pro-2-15","title":"Proverbs 2:15","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":15,"chapterEnd":2,"verseEnd":15},"content":"<p>De 32:5; Ps 125:5; Isa 30:8-13; 59:8; Php 2:15</p>"},{"id":"tsk-pro-2-16","title":"Proverbs 2:16","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":16,"chapterEnd":2,"verseEnd":16},"content":"<p>deliver. 5:3-20; 6:24; 7:5-23; 22:14; 23:27; Ge 39:3-12; Ne 13:26,27; Ec 7:26 flattereth. 7:21; 29:5</p>"},{"id":"tsk-pro-2-17","title":"Proverbs 2:17","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":17,"chapterEnd":2,"verseEnd":17},"content":"<p>the guide. 5:18; Jer 3:4 forgetteth. Eze 16:8,59,60; Mal 2:14-16</p>"},{"id":"tsk-pro-2-18","title":"Proverbs 2:18","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":18,"chapterEnd":2,"verseEnd":18},"content":"<p>5:4-14; 6:26-35; 7:22-27; 9:18; 1Co 6:9-11; Ga 5:19-21; Eph 5:5 Re 21:8; 22:15</p>"},{"id":"tsk-pro-2-19","title":"Proverbs 2:19","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":19,"chapterEnd":2,"verseEnd":19},"content":"<p>None. Ps 81:12; Ec 7:26; Jer 13:23; Ho 4:14; Mt 19:24-26 take. 4:18; Heb 6:18</p>"},{"id":"tsk-pro-2-20","title":"Proverbs 2:20","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":20,"chapterEnd":2,"verseEnd":20},"content":"<p>13:20; Ps 119:63,115; So 1:7,8; Jer 6:16; Heb 6:12; 3Jo 1:11</p>"},{"id":"tsk-pro-2-21","title":"Proverbs 2:21","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":21,"chapterEnd":2,"verseEnd":21},"content":"<p>Job 1:1; 42:12; Ps 37:3,9,11,22,29; 84:11; 112:4-6</p>"},{"id":"tsk-pro-2-22","title":"Proverbs 2:22","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":2,"verseStart":22,"chapterEnd":2,"verseEnd":22},"content":"<p>the wicked. 5:22,23; Job 18:16-18; 21:30; Ps 37:20,22,28,37,38; 52:5; 104:35 Ps 145:20; Isa 3:10,11 rooted. or, plucked up. De 7:22; *marg: De 28:64</p>"}]}