{"entries":[{"id":"tsk-pro-14-1","title":"Proverbs 14:1","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":1,"chapterEnd":14,"verseEnd":1},"content":"<p>24:3,4; 31:10-31; Ru 4:11 the foolish. 9:13-15; 19:13; 21:9,19; 1Ki 16:31; 21:24,25; 2Ki 11:1</p>"},{"id":"tsk-pro-14-2","title":"Proverbs 14:2","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":2,"chapterEnd":14,"verseEnd":2},"content":"<p>that walketh. 16:17; 28:6; 1Ki 3:6; Job 1:1; 28:28; Ps 25:21; 112:1; Ec 12:13 Mal 2:5,6; Ac 9:31; 10:22,35 but. 11:12; Job 12:4; Ps 123:3,4; Lu 10:16; 16:14; Ro 2:4,5; 2Ti 3:2,3</p>"},{"id":"tsk-pro-14-3","title":"Proverbs 14:3","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":3,"chapterEnd":14,"verseEnd":3},"content":"<p>the mouth. 18:6; 21:24; 22:8; 28:25; 1Sa 2:3; Job 5:21; Ps 12:3; 31:18; 52:1,2 Ps 57:4; Da 7:20; Jas 3:5,6; 2Pe 2:18; Re 15:5,6 but. 12:6; Ro 10:9,10; Re 3:10; 12:11</p>"},{"id":"tsk-pro-14-4","title":"Proverbs 14:4","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":4,"chapterEnd":14,"verseEnd":4},"content":"<p>clean. Am 4:6 but. 13:23; 1Co 9:9-11</p>"},{"id":"tsk-pro-14-5","title":"Proverbs 14:5","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":5,"chapterEnd":14,"verseEnd":5},"content":"<p>25; 6:19; 12:17; 13:5; 19:5,9; Ex 20:16; 23:1; 1Ki 21:13; 22:12-14</p>"},{"id":"tsk-pro-14-6","title":"Proverbs 14:6","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":6,"chapterEnd":14,"verseEnd":6},"content":"<p>scorner. 18:2; 26:12; Isa 8:20; Jer 8:9; Mt 6:22,23; 11:25-27; Ro 1:21-28 Ro 9:31,32; 1Co 3:18,19; 8:2; 2Pe 3:3-5 knowledge. 8:9; 17:24; Ps 119:18,98-100; Mt 13:11,12; Jas 1:5</p>"},{"id":"tsk-pro-14-7","title":"Proverbs 14:7","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":7,"chapterEnd":14,"verseEnd":7},"content":"<p>9:6; 13:20; 19:27; 1Co 5:11; Eph 5:11</p>"},{"id":"tsk-pro-14-8","title":"Proverbs 14:8","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":8,"chapterEnd":14,"verseEnd":8},"content":"<p>wisdom. 2:9; 8:20; Ps 111:10; 119:5,34,35,73; 143:8; Eph 5:17; Col 1:9,10 2Ti 3:15-17; Jas 3:13 folly. 11:18; Jer 13:20; *marg: Lu 12:19,20; Eph 4:22; 2Ti 3:13</p>"},{"id":"tsk-pro-14-9","title":"Proverbs 14:9","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":9,"chapterEnd":14,"verseEnd":9},"content":"<p>Fools. 1:22; 10:23; 26:18,19; 30:20; Job 15:16; 34:7-9; Jude 1:18 among. 3:4; 8:35; 12:2; 13:15; Ro 14:17,18</p>"},{"id":"tsk-pro-14-10","title":"Proverbs 14:10","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":10,"chapterEnd":14,"verseEnd":10},"content":"<p>heart. 15:13; 18:14; 1Sa 1:10; 2Ki 4:27; Job 6:2-4; 7:11; 9:18; 10:1 Eze 3:14; Mr 14:33,34; Joh 12:27 his, etc. Heb. the bitterness of his soul. Ge 42:21 and. Ps 25:14; Joh 14:18,23; Php 4:7; 1Pe 1:8; Re 2:17</p>"},{"id":"tsk-pro-14-11","title":"Proverbs 14:11","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":11,"chapterEnd":14,"verseEnd":11},"content":"<p>house. 3:33; 12:7; 21:12; Job 8:15; 15:34; 18:14,15,21; 20:26-28; 21:28 Job 27:13-23; Zec 5:4; Mt 7:26,27 the tabernacle. 11:28; 21:20; Job 8:6; Ps 112:2,3; 128:3; Isa 58:11,12</p>"},{"id":"tsk-pro-14-12","title":"Proverbs 14:12","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":12,"chapterEnd":14,"verseEnd":12},"content":"<p>12:15; 16:25; 30:12; Mt 7:13,14; Lu 13:24; Ro 6:21; Ga 6:3; Eph 5:6 Jas 1:22</p>"},{"id":"tsk-pro-14-13","title":"Proverbs 14:13","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":13,"chapterEnd":14,"verseEnd":13},"content":"<p>5:4; Ec 2:2,10,11; 7:5,6; 11:9; Lu 16:25; Jas 4:9; Re 18:7,8</p>"},{"id":"tsk-pro-14-14","title":"Proverbs 14:14","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":14,"chapterEnd":14,"verseEnd":14},"content":"<p>backslider. 1:32; Jer 2:19; 8:5; 17:5; Ho 4:16; Zep 1:6; Heb 3:12; 2Pe 2:20-22 filled. 1:31; 12:14; Eze 22:31 a good. 10; Joh 4:14; 2Co 1:12; Ga 6:4,8</p>"},{"id":"tsk-pro-14-15","title":"Proverbs 14:15","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":15,"chapterEnd":14,"verseEnd":15},"content":"<p>simple. 4:26; 22:3; 27:12; Ro 16:18,19; Eph 4:14; 5:17; 1Jo 4:1 the prudent. 8; Am 5:13; Ac 13:7</p>"},{"id":"tsk-pro-14-16","title":"Proverbs 14:16","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":16,"chapterEnd":14,"verseEnd":16},"content":"<p>feareth. 3:7; 16:6,17; 22:3; Ge 33:9; 42:18; Ne 5:15; Job 31:21-23 Ps 119:120; 1Th 5:22 the fool. 7:22; 28:14; 29:9; 1Ki 19:2; 20:10,11,18; Ec 10:13 Mr 6:17-19,24,25; Joh 9:40</p>"},{"id":"tsk-pro-14-17","title":"Proverbs 14:17","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":17,"chapterEnd":14,"verseEnd":17},"content":"<p>that. 29; 12:16; 15:18; 16:32; 22:24; 29:22; Ec 7:9; Jas 1:19 a man. 6:18; 12:2; Es 3:6; 7:5,6; Isa 32:7; Jer 5:26-29</p>"},{"id":"tsk-pro-14-18","title":"Proverbs 14:18","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":18,"chapterEnd":14,"verseEnd":18},"content":"<p>inherit. 3:35; 11:29; Jer 16:19; 44:17; Mt 23:29-32; 1Pe 1:18 the prudent. 4:7-9; 11:30; Da 12:3; 2Ti 4:8; 1Pe 5:4</p>"},{"id":"tsk-pro-14-19","title":"Proverbs 14:19","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":19,"chapterEnd":14,"verseEnd":19},"content":"<p>Ge 42:6; 43:28; Ex 8:8; 9:27,28; 11:8; 2Ki 3:12; Es 7:7,8; Ps 49:14 Isa 60:14; Mic 7:9,10,16,17; Mal 4:3; Ac 16:39; Re 3:9</p>"},{"id":"tsk-pro-14-20","title":"Proverbs 14:20","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":20,"chapterEnd":14,"verseEnd":20},"content":"<p>poor. 10:15; 19:7; Job 6:21-23; 19:13,14; 30:10 but. 19:4,6; Es 3:2; 5:10,11 the rich hath many friends. Heb. many are the lovers of therich.</p>"},{"id":"tsk-pro-14-21","title":"Proverbs 14:21","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":21,"chapterEnd":14,"verseEnd":21},"content":"<p>that despiseth. 11:12; 17:5; 18:3; Job 31:13-15; 35:5,6; Ps 22:24; Lu 18:9 Jas 2:5,6,14-16 he that hath. 31; 11:24,25; 19:17; 28:27; Ps 41:1,2; 112:5,9; Ec 11:1,2 Isa 58:7-12; Da 4:27; Mt 25:34-46; Lu 6:30-36; Ac 20:35; Heb 6:12 1Jo 3:17-22</p>"},{"id":"tsk-pro-14-22","title":"Proverbs 14:22","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":22,"chapterEnd":14,"verseEnd":22},"content":"<p>err. 17; 12:2; Isa 32:7,8 but. Ge 24:27; Ps 25:10; 61:7; Mt 5:7; Joh 1:17 devise. 19:22; 2Ch 6:8</p>"},{"id":"tsk-pro-14-23","title":"Proverbs 14:23","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":23,"chapterEnd":14,"verseEnd":23},"content":"<p>all. 12:24; 28:19; Joh 6:27; Heb 6:10,11 but. 10:10; Ec 5:3; 2Th 3:10-12; 1Ti 5:13</p>"},{"id":"tsk-pro-14-24","title":"Proverbs 14:24","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":24,"chapterEnd":14,"verseEnd":24},"content":"<p>crown. Ps 112:9; Ec 7:11,12; Isa 33:6; Lu 16:9 foolishness. 27:22; Ps 49:10-13; Lu 12:19,20; 16:19-25</p>"},{"id":"tsk-pro-14-25","title":"Proverbs 14:25","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":25,"chapterEnd":14,"verseEnd":25},"content":"<p>5; Ac 20:21,26,27; 26:16-20; 1Ti 4:1-3; 2Pe 3:3</p>"},{"id":"tsk-pro-14-26","title":"Proverbs 14:26","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":26,"chapterEnd":14,"verseEnd":26},"content":"<p>fear. 3:7,8,25,26; 19:23; Ge 31:42; Ps 34:7-11; 112:1,6-8; 115:13,14 Ec 7:18; Mal 3:16-18; 4:2; Ac 9:31 his. 18:10; Isa 26:20,21; Jer 15:11; 32:39,40</p>"},{"id":"tsk-pro-14-27","title":"Proverbs 14:27","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":27,"chapterEnd":14,"verseEnd":27},"content":"<p>a fountain. 13:14; Isa 33:6; Re 21:6 to. 2:10-18; 22:5; Ps 18:5; Ec 7:26</p>"},{"id":"tsk-pro-14-28","title":"Proverbs 14:28","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":28,"chapterEnd":14,"verseEnd":28},"content":"<p>Ex 1:12,22; 1Ki 4:20,21; 20:27; 2Ki 10:32,33; 13:7</p>"},{"id":"tsk-pro-14-29","title":"Proverbs 14:29","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":29,"chapterEnd":14,"verseEnd":29},"content":"<p>slow. 17; 15:18; 16:32; Nu 12:3; Mt 11:29; 1Co 13:4,5; Jas 1:19; 3:17,18 but. 22:24,25; 25:8,28; Ec 7:9; Da 3:19-25; Mt 2:16 hasty. Heb. short. exalteth. 4:8; Ec 10:6</p>"},{"id":"tsk-pro-14-30","title":"Proverbs 14:30","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":30,"chapterEnd":14,"verseEnd":30},"content":"<p>sound. 4:23; Ps 119:80; 2Ti 1:7 envy. Job 5:2; Ps 112:10; Ac 7:9; Ro 1:29; Jas 4:5 rottenness. 3:8; 12:4; 17:22</p>"},{"id":"tsk-pro-14-31","title":"Proverbs 14:31","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":31,"chapterEnd":14,"verseEnd":31},"content":"<p>that oppresseth. 17:5; 22:2,16,22,23; Job 31:13-16; Ps 12:5; Ec 5:8; Mt 25:40-46 but. 21; 19:17; Mt 25:40; Joh 12:8; 2Co 8:7-9; 1Jo 3:17-21; 4:21</p>"},{"id":"tsk-pro-14-32","title":"Proverbs 14:32","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":32,"chapterEnd":14,"verseEnd":32},"content":"<p>driven. Job 18:18; 27:20-22; Ps 58:9; Da 5:26-30; Joh 8:21,24; Ro 9:22 1Th 5:3 the righteous. Ge 49:18; Job 13:15; 19:25-27; Ps 23:4; 37:37; Lu 2:29 1Co 15:55-58; 2Co 1:9; 5:8; Php 1:21,23; 2Ti 4:18; Re 14:13</p>"},{"id":"tsk-pro-14-33","title":"Proverbs 14:33","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":33,"chapterEnd":14,"verseEnd":33},"content":"<p>12:16,23; 13:16; 15:2,28; 29:11; Ec 10:3</p>"},{"id":"tsk-pro-14-34","title":"Proverbs 14:34","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":34,"chapterEnd":14,"verseEnd":34},"content":"<p>Righteousness. De 4:6-8; 28:1-14; Jud 2:6-14; Jer 2:2-25; Ho 13:1 but. De 28:15-68; 29:18-28; Ps 107:34; Eze 16:1-63; 22:1-23:49 any people. Heb. nations.</p>"},{"id":"tsk-pro-14-35","title":"Proverbs 14:35","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":14,"verseStart":35,"chapterEnd":14,"verseEnd":35},"content":"<p>king's. 19:12,13; 20:8,26; 22:11; 25:5; 29:12; Ps 101:4-8; Mt 24:45-51 Lu 12:42-48 him. 10:5; 17:2; 19:26</p>"}]}