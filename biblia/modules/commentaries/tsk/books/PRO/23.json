{"entries":[{"id":"tsk-pro-23-2","title":"Proverbs 23:2","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":2,"chapterEnd":23,"verseEnd":2},"content":"<p>Mt 18:8,9; 1Co 9:27; Php 3:19</p>"},{"id":"tsk-pro-23-3","title":"Proverbs 23:3","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":3,"chapterEnd":23,"verseEnd":3},"content":"<p>6; Ps 141:4; Da 1:8; Lu 21:34; Eph 4:22</p>"},{"id":"tsk-pro-23-4","title":"Proverbs 23:4","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":4,"chapterEnd":23,"verseEnd":4},"content":"<p>Labour. 28:20; Joh 6:27; 1Ti 6:8-10 cease. 3:5; 26:12; Isa 5:21; Ro 11:25; 12:16</p>"},{"id":"tsk-pro-23-5","title":"Proverbs 23:5","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":5,"chapterEnd":23,"verseEnd":5},"content":"<p>thou. Ps 119:36,37; Jer 22:17; 1Jo 2:16 set thine eyes upon. Heb. cause thine eyes to fly upon, etc.\"He expresses it in such a way,\" says Abp. Tillotson, \"as if a rich man sat brooding over an estate till it was fledged, and gotten itself wings to fly away.\"</p>\n<p>that which. Ge 42:36; Ec 1:2; 12:8; Isa 55:2; 1Co 7:29-31 riches. 27:24; Job 1:14-17; Ps 39:6; Ec 5:13,14; Mt 6:19; 1Ti 6:17 Jas 5:1,2</p>"},{"id":"tsk-pro-23-6","title":"Proverbs 23:6","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":6,"chapterEnd":23,"verseEnd":6},"content":"<p>an. 22:9; De 15:9; 28:56; Mt 20:15; Mr 7:22 desire. 3; Ps 141:4; Da 1:8-10</p>"},{"id":"tsk-pro-23-7","title":"Proverbs 23:7","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":7,"chapterEnd":23,"verseEnd":7},"content":"<p>as. 19:22; Mt 9:3,4; Lu 7:39 Eat. Jud 16:15; 2Sa 13:26-28; Ps 12:2; 55:21; Da 11:27; Lu 11:37-54</p>"},{"id":"tsk-pro-23-9","title":"Proverbs 23:9","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":9,"chapterEnd":23,"verseEnd":9},"content":"<p>Speak. 9:7,8; 26:4,5; Isa 36:21; Mt 7:6; Ac 13:45,46; 28:25-28 he. Lu 16:14; Joh 8:52; 9:30-34,40; 10:20; Ac 17:18,32; 1Co 1:21-24 1Co 4:10-13</p>"},{"id":"tsk-pro-23-10","title":"Proverbs 23:10","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":10,"chapterEnd":23,"verseEnd":10},"content":"<p>Remove. 22:28; De 19:14; 27:17; Job 24:2 landmark. or, bound. fatherless. Job 6:27; 22:9; 24:3,9; 31:21-23; Ps 94:6; Jer 7:5; 22:3; Zec 7:10 Mal 3:5; Jas 1:27</p>"},{"id":"tsk-pro-23-11","title":"Proverbs 23:11","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":11,"chapterEnd":23,"verseEnd":11},"content":"<p>22:23; Ex 22:22-24; De 27:19; Ps 12:5; Jer 50:33,34; 51:36</p>"},{"id":"tsk-pro-23-12","title":"Proverbs 23:12","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":12,"chapterEnd":23,"verseEnd":12},"content":"<p>19; 2:2-6; 5:1,2; 22:17; Eze 33:31; Mt 13:52; Jas 1:21-25</p>"},{"id":"tsk-pro-23-13","title":"Proverbs 23:13","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":13,"chapterEnd":23,"verseEnd":13},"content":"<p>13:24; 19:18; 29:15,17</p>"},{"id":"tsk-pro-23-14","title":"Proverbs 23:14","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":14,"chapterEnd":23,"verseEnd":14},"content":"<p>22:15; 1Co 5:5; 11:32</p>"},{"id":"tsk-pro-23-15","title":"Proverbs 23:15","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":15,"chapterEnd":23,"verseEnd":15},"content":"<p>My son. 1:10; 2:1; 4:1; Mt 9:2; Joh 21:5; 1Jo 2:1 if. 24,25; 10:1; 15:20; 29:3; 1Th 2:19,20; 3:8,9; 2Jo 1:4; 3Jo 1:3,4 even mine. or, even I will rejoice. Jer 32:41; Zep 3:17; Lu 15:23,24,32; Joh 15:11</p>"},{"id":"tsk-pro-23-16","title":"Proverbs 23:16","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":16,"chapterEnd":23,"verseEnd":16},"content":"<p>thy. 8:6; Eph 4:29; 5:4; Col 4:4; Jas 3:2</p>"},{"id":"tsk-pro-23-17","title":"Proverbs 23:17","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":17,"chapterEnd":23,"verseEnd":17},"content":"<p>not. 3:31; 24:1; Ps 37:1-3; 73:3-7 be thou. 15:16; 28:14; Ps 111:10; 112:1; Ec 5:7; 12:13,14; Ac 9:31; 2Co 7:1 1Pe 1:17</p>"},{"id":"tsk-pro-23-18","title":"Proverbs 23:18","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":18,"chapterEnd":23,"verseEnd":18},"content":"<p>surely. Ps 37:37; Jer 29:11; Lu 16:25; Ro 6:21,22 end. or, reward. 24:14; Heb 10:35 thine. Ps 9:18; Jer 29:11; Php 1:20</p>"},{"id":"tsk-pro-23-19","title":"Proverbs 23:19","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":19,"chapterEnd":23,"verseEnd":19},"content":"<p>and guide. 12,26; 4:10-23 in the way.That is \"in the right way.\"</p>"},{"id":"tsk-pro-23-20","title":"Proverbs 23:20","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":20,"chapterEnd":23,"verseEnd":20},"content":"<p>not. 29-35; 20:1; 28:7; 31:6,7; Isa 5:11,22; 22:13; Mt 24:49; Lu 15:13 Lu 16:19; 21:34; Ro 13:13; Eph 5:18; 1Pe 4:3,4 flesh. Heb. their flesh.</p>"},{"id":"tsk-pro-23-21","title":"Proverbs 23:21","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":21,"chapterEnd":23,"verseEnd":21},"content":"<p>the drunkard. 21:17; De 21:20; Isa 28:1-3; Joe 1:5; 1Co 5:11; 6:10; Ga 5:21 Php 3:19 drowsiness. 6:9-11; 19:15; 24:30-34</p>"},{"id":"tsk-pro-23-22","title":"Proverbs 23:22","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":22,"chapterEnd":23,"verseEnd":22},"content":"<p>Hearken. 1:8; 6:20; De 21:18-21; 27:16; Mr 7:10; Eph 6:1,2 despise. 30:11; Le 19:3; Mt 15:4-6; Joh 19:26,27</p>"},{"id":"tsk-pro-23-23","title":"Proverbs 23:23","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":23,"chapterEnd":23,"verseEnd":23},"content":"<p>Buy. 2:2-4; 4:5-7; 10:1; 16:16; 17:16; Job 28:12-19; Ps 119:72,127 Isa 55:1; Mt 13:44,46; Php 3:7,8; Re 3:18 sell. Mt 16:26; Ac 20:23; Heb 11:26; Re 12:11</p>"},{"id":"tsk-pro-23-24","title":"Proverbs 23:24","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":24,"chapterEnd":23,"verseEnd":24},"content":"<p>father. 15,16; 10:1; 15:20; 1Ki 1:48; 2:1-3,9; Ec 2:19 shall have. Phm 1:9,20</p>"},{"id":"tsk-pro-23-25","title":"Proverbs 23:25","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":25,"chapterEnd":23,"verseEnd":25},"content":"<p>and she. 17:25; 1Ch 4:9,10; Lu 1:31-33,40-47,58; 11:27,28</p>"},{"id":"tsk-pro-23-26","title":"Proverbs 23:26","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":26,"chapterEnd":23,"verseEnd":26},"content":"<p>My son. 15 give. 4:23; De 6:5; Mt 10:37,38; Lu 14:26; 2Co 5:14,15; 8:5; Eph 3:17 let. 4:25-27; Ps 107:43; 119:2,9-11; Ho 14:9; 2Pe 1:19</p>"},{"id":"tsk-pro-23-27","title":"Proverbs 23:27","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":27,"chapterEnd":23,"verseEnd":27},"content":"<p>22:14</p>"},{"id":"tsk-pro-23-28","title":"Proverbs 23:28","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":28,"chapterEnd":23,"verseEnd":28},"content":"<p>as for a prey. or, as a robber. 2:16-19; 7:12,22-27; 9:18; 22:14; Jud 16:4-22; Ec 7:26; Jer 3:2 increaseth. Nu 25:1; Ho 4:11; 1Co 10:8; Re 17:1,2</p>"},{"id":"tsk-pro-23-29","title":"Proverbs 23:29","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":29,"chapterEnd":23,"verseEnd":29},"content":"<p>Who hath woe. 21; 20:1; 1Sa 25:36,37; 2Sa 13:28; 1Ki 20:16-22; Isa 5:11,22 Isa 28:7,8; Na 1:10; Mt 24:49,50; Lu 12:45,46; Eph 5:18 redness. Ge 49:12</p>"},{"id":"tsk-pro-23-30","title":"Proverbs 23:30","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":30,"chapterEnd":23,"verseEnd":30},"content":"<p>tarry. 20:1; Ge 9:21; Isa 5:11; Am 6:6; Eph 5:18 mixed.That is, not wine diluted and lowered with water, but made stronger and more inebriating, by the addition of more powerful ingredients, as honey, spices, myrrh, defrutum, opiates, etc.</p>\n<p>9:2; Ps 75:8</p>"},{"id":"tsk-pro-23-31","title":"Proverbs 23:31","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":31,"chapterEnd":23,"verseEnd":31},"content":"<p>6:25; 2Sa 11:2; Job 33:1; Ps 119:37; Mt 5:28-30; Mr 9:47; 1Jo 2:16</p>"},{"id":"tsk-pro-23-32","title":"Proverbs 23:32","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":32,"chapterEnd":23,"verseEnd":32},"content":"<p>At. 5:11; Isa 28:3,7,8; Jer 5:31; Ex 7:5,6,12; Lu 16:25,26; Ro 6:21 biteth. Ec 10:8; Jer 8:17; Am 5:19; 9:3 an adder. or, a cockatrice. Isa 59:5</p>"},{"id":"tsk-pro-23-33","title":"Proverbs 23:33","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":33,"chapterEnd":23,"verseEnd":33},"content":"<p>eyes. Ge 19:32-38 and. 31:5; Ps 69:12; Da 5:4; Ho 7:5; Jude 1:12,13</p>"},{"id":"tsk-pro-23-34","title":"Proverbs 23:34","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":34,"chapterEnd":23,"verseEnd":34},"content":"<p>thou. 1Sa 25:33-38; 30:16,17; 2Sa 13:28; 1Ki 16:9; 20:16-22; Joe 1:5 Mt 24:38; Lu 17:27-29; 21:34; 1Th 5:2-7 midst. Heb. heart. Ex 15:8</p>"},{"id":"tsk-pro-23-35","title":"Proverbs 23:35","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":23,"verseStart":35,"chapterEnd":23,"verseEnd":35},"content":"<p>stricken. 27:22; Jer 5:3; 31:18 I felt it not. Heb. I knew it not. Eph 4:19 I will. 26:11; De 29:19; Isa 22:13; 56:12; 1Co 15:32-34; 2Pe 2:22</p>"}]}