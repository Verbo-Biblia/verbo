{"entries":[{"id":"tsk-pro-9-1","title":"Proverbs 9:1","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":1,"chapterEnd":9,"verseEnd":1},"content":"<p>1 The discipline, 4 and doctrine of wisdom. 13 The custom, 16 and error of folly.</p>\n<p>Wisdom.The infinite and eternal Wisdom of God, which has so framed the universe as to exhibit a scene of grandeur and stability, and made ample provision for the innumerable beings by which it is inhabited.</p>\n<p>builded. Mt 16:18; 1Co 3:9-15; Eph 2:20-22; 1Ti 3:15; Heb 3:3-6; 1Pe 2:5,6 pillars. 1Ki 7:2,3,6,21; Ga 2:9; Re 3:12</p>"},{"id":"tsk-pro-9-2","title":"Proverbs 9:2","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":2,"chapterEnd":9,"verseEnd":2},"content":"<p>killed. Isa 25:6; Mt 22:3,4-14; 1Co 5:7,8 beasts. Heb. killing. Ge 43:16 mingled. 5; 23:30; Lu 14:17</p>"},{"id":"tsk-pro-9-3","title":"Proverbs 9:3","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":3,"chapterEnd":9,"verseEnd":3},"content":"<p>sent. Mt 22:3,4,9; Lu 11:49; 14:17,21-23; Ro 10:15; 2Co 5:20,21 she crieth. 14; 1:20-23; 8:1-3; Joh 7:37; 18:20</p>"},{"id":"tsk-pro-9-4","title":"Proverbs 9:4","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":4,"chapterEnd":9,"verseEnd":4},"content":"<p>16; 1:22; 6:32; 8:5; Ps 19:7; 119:130; Mt 11:25; Re 3:17,18; 22:17</p>"},{"id":"tsk-pro-9-5","title":"Proverbs 9:5","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":5,"chapterEnd":9,"verseEnd":5},"content":"<p>2,17; Ps 22:26,29; So 5:1; Isa 55:1-3; Jer 31:12-14; Mt 26:26-28 Joh 6:27,49-58</p>"},{"id":"tsk-pro-9-6","title":"Proverbs 9:6","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":6,"chapterEnd":9,"verseEnd":6},"content":"<p>Forsake. 4:14,15; 13:20; Ps 26:4-6; 45:10; 119:115; Ac 2:40; 2Co 6:17 Re 18:4 in. 4:11; 10:17; Mt 7:13,14; Lu 13:24</p>"},{"id":"tsk-pro-9-7","title":"Proverbs 9:7","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":7,"chapterEnd":9,"verseEnd":7},"content":"<p>15:12; Ge 19:8,9; 1Ki 18:17; 21:20; 22:24,27; 2Ch 24:20-22 2Ch 25:15,16; 36:16</p>"},{"id":"tsk-pro-9-8","title":"Proverbs 9:8","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":8,"chapterEnd":9,"verseEnd":8},"content":"<p>Reprove. 23:9; 29:1; Nu 14:6-10; 1Ki 22:8; Mt 7:6; 15:14; Heb 6:4-8 rebuke. 13:18; 28:23; Le 19:17; 2Sa 12:7-14; 1Ki 1:23,32; Ps 141:5 Ga 2:11-14; 2Pe 3:15,16</p>"},{"id":"tsk-pro-9-9","title":"Proverbs 9:9","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":9,"chapterEnd":9,"verseEnd":9},"content":"<p>1:5; 25:12; Ho 6:3; Mt 13:11,12; 2Pe 3:18; 1Jo 2:20,21; 5:13</p>"},{"id":"tsk-pro-9-10","title":"Proverbs 9:10","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":10,"chapterEnd":9,"verseEnd":10},"content":"<p>The fear. 1:7; Job 28:28; Ps 111:10; Ec 12:13 the knowledge. 2:5; 30:3; 1Ch 28:9; Mt 11:27; Joh 17:3; 1Jo 5:20</p>"},{"id":"tsk-pro-9-11","title":"Proverbs 9:11","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":11,"chapterEnd":9,"verseEnd":11},"content":"<p>3:2,16; 10:27; De 6:2</p>"},{"id":"tsk-pro-9-12","title":"Proverbs 9:12","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":12,"chapterEnd":9,"verseEnd":12},"content":"<p>16:26; Job 22:2,3,21; 35:6,7; Isa 28:22; Eze 18:20; 2Pe 3:3,4,16</p>"},{"id":"tsk-pro-9-13","title":"Proverbs 9:13","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":13,"chapterEnd":9,"verseEnd":13},"content":"<p>7:11; 21:9,19; 1Ti 6:4; *marg:</p>"},{"id":"tsk-pro-9-14","title":"Proverbs 9:14","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":14,"chapterEnd":9,"verseEnd":14},"content":"<p>she. 7:10-12 in. 3</p>"},{"id":"tsk-pro-9-15","title":"Proverbs 9:15","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":15,"chapterEnd":9,"verseEnd":15},"content":"<p>7:13-15,25-27; 23:27,28</p>"},{"id":"tsk-pro-9-17","title":"Proverbs 9:17","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":17,"chapterEnd":9,"verseEnd":17},"content":"<p>Stolen. 20:17; 23:31,32; Ge 3:6; Ro 7:8; Jas 1:14,15 eaten in secret. Heb. of secrecies. 7:18-20; 30:20; 2Ki 5:24-27; Eph 5:12</p>"},{"id":"tsk-pro-9-18","title":"Proverbs 9:18","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":9,"verseStart":18,"chapterEnd":9,"verseEnd":18},"content":"<p>he. 1:7; Ps 82:5; 2Pe 3:5 the dead. 2:18,19; 5:5; 6:26; 7:27</p>"}]}