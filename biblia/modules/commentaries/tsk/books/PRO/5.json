{"entries":[{"id":"tsk-pro-5-1","title":"Proverbs 5:1","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":1,"chapterEnd":5,"verseEnd":1},"content":"<p>1 Solomon exhorts to wisdom. 3 He shews the mischief of whoredom and riot. 15 He exhorts to contentedness, liberality, and chastity. 22 The wicked are overtaken with their own sins.</p>\n<p>attend. 2:1; 4:1,20; Mt 3:9; Mr 4:23; Re 2:7,11,17,29; 3:6,13,22 bow. 22:17; Jas 1:19</p>"},{"id":"tsk-pro-5-2","title":"Proverbs 5:2","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":2,"chapterEnd":5,"verseEnd":2},"content":"<p>thy lips. 10:21; 15:2,7; 16:23; 20:15; Ps 45:2; 71:15; 119:13; So 4:11 Mal 2:6,7</p>"},{"id":"tsk-pro-5-3","title":"Proverbs 5:3","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":3,"chapterEnd":5,"verseEnd":3},"content":"<p>the lips. 2:16; 6:24; 7:21; Re 17:2-6 mouth. Heb. palate. smoother. Ps 55:21</p>"},{"id":"tsk-pro-5-4","title":"Proverbs 5:4","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":4,"chapterEnd":5,"verseEnd":4},"content":"<p>her. 6:24-35; 7:22,23; 9:18; 23:27,28; Ec 7:26; Heb 12:15,16 sharp. Jud 16:4-6,15-21; Ps 55:21; Heb 4:12</p>"},{"id":"tsk-pro-5-5","title":"Proverbs 5:5","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":5,"chapterEnd":5,"verseEnd":5},"content":"<p>2:18,19; 7:27</p>"},{"id":"tsk-pro-5-6","title":"Proverbs 5:6","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":6,"chapterEnd":5,"verseEnd":6},"content":"<p>ponder. 4:26; Ps 119:59 the path. 11:19; Ps 16:11 her. 6:12,13; 7:10-21; 2Th 2:9,10</p>"},{"id":"tsk-pro-5-7","title":"Proverbs 5:7","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":7,"chapterEnd":5,"verseEnd":7},"content":"<p>Hear. 4:1; 8:32-36; 22:17-21; Heb 12:25 and depart. 3:21; 4:21</p>"},{"id":"tsk-pro-5-8","title":"Proverbs 5:8","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":8,"chapterEnd":5,"verseEnd":8},"content":"<p>4:15; 6:27,28; Mt 6:13; Eph 5:11</p>"},{"id":"tsk-pro-5-9","title":"Proverbs 5:9","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":9,"chapterEnd":5,"verseEnd":9},"content":"<p>6:29-35; Ge 38:23-26; Jud 16:19-21; Ne 13:26; Ho 4:13,14</p>"},{"id":"tsk-pro-5-10","title":"Proverbs 5:10","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":10,"chapterEnd":5,"verseEnd":10},"content":"<p>strangers. 6:35; Ho 7:9; Lu 15:30 wealth. Heb. strength. 31:3</p>"},{"id":"tsk-pro-5-11","title":"Proverbs 5:11","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":11,"chapterEnd":5,"verseEnd":11},"content":"<p>thou. 7:23; De 32:29; Jer 5:31; Ro 6:21; Heb 13:4; Re 21:8; 22:15 when. Nu 5:27; 1Co 5:4,5</p>"},{"id":"tsk-pro-5-12","title":"Proverbs 5:12","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":12,"chapterEnd":5,"verseEnd":12},"content":"<p>How. 1:7,22,29,30; 15:5; Ps 50:17; 73:22; Zec 7:11-14; Joh 3:19,20 and my. 1:25; 6:23; 12:1; 13:18; Ge 19:9; Ex 2:13,14; 2Ch 24:20-22; 25:16 2Ch 33:10,11; 36:16; Jer 44:4; Zec 1:4-6</p>"},{"id":"tsk-pro-5-13","title":"Proverbs 5:13","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":13,"chapterEnd":5,"verseEnd":13},"content":"<p>Lu 15:18; 1Th 4:8; 5:12,13; Heb 13:7</p>"},{"id":"tsk-pro-5-14","title":"Proverbs 5:14","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":14,"chapterEnd":5,"verseEnd":14},"content":"<p>13:20; Nu 25:1-6; Ho 4:11-14; 1Co 10:6-8; 2Pe 2:10-18; Jude 1:7-13</p>"},{"id":"tsk-pro-5-15","title":"Proverbs 5:15","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":15,"chapterEnd":5,"verseEnd":15},"content":"<p>18,19; 1Co 7:2-5; Heb 13:4</p>"},{"id":"tsk-pro-5-16","title":"Proverbs 5:16","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":16,"chapterEnd":5,"verseEnd":16},"content":"<p>thy. De 33:28; Ps 68:26; Isa 48:21 dispersed. Ge 24:60; Jud 12:9; Ps 127:3; 128:3</p>"},{"id":"tsk-pro-5-18","title":"Proverbs 5:18","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":18,"chapterEnd":5,"verseEnd":18},"content":"<p>rejoice. Ec 9:9; Mal 2:14,15</p>"},{"id":"tsk-pro-5-19","title":"Proverbs 5:19","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":19,"chapterEnd":5,"verseEnd":19},"content":"<p>as the. So 2:9; 4:5; 7:3; 8:14 satisfy thee. Heb. water thee. 5:15 be thou ravished always with her love. Heb. err thou alwaysin her love. 2Sa 12:4</p>"},{"id":"tsk-pro-5-20","title":"Proverbs 5:20","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":20,"chapterEnd":5,"verseEnd":20},"content":"<p>with. 2:16-19; 6:24; 7:5; 22:14; 23:27,28,33; 1Ki 11:1</p>"},{"id":"tsk-pro-5-21","title":"Proverbs 5:21","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":21,"chapterEnd":5,"verseEnd":21},"content":"<p>15:3; 2Ch 16:9; Job 31:4; 34:21; Ps 11:4; 17:3; 139:1-12; Jer 16:17 Jer 17:10; 23:24; 32:19; Ho 7:2; Heb 4:13; Re 2:18,23</p>"},{"id":"tsk-pro-5-22","title":"Proverbs 5:22","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":22,"chapterEnd":5,"verseEnd":22},"content":"<p>His. 1:18,31; 11:3,5; Ps 7:15,16; 9:15; Jer 2:19; Ho 4:11-14; Ga 6:7,8 holden. Ec 7:26 sins. Heb. sin. 1Co 5:9,10; Ga 5:19-21; Eph 5:5,6; Heb 13:4</p>"},{"id":"tsk-pro-5-23","title":"Proverbs 5:23","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":5,"verseStart":23,"chapterEnd":5,"verseEnd":23},"content":"<p>shall die. 10:21; 14:32; Job 4:21; 36:12 in the. 14:14; Ps 81:12; 2Pe 2:15-22</p>"}]}