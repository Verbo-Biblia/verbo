{"entries":[{"id":"tsk-pro-13-1","title":"Proverbs 13:1","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":1,"chapterEnd":13,"verseEnd":1},"content":"<p>4:1-14,20-22; 10:1; 15:5,20 but. 9:7,8; 14:6; 1Sa 2:25; Isa 28:14,15</p>"},{"id":"tsk-pro-13-2","title":"Proverbs 13:2","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":2,"chapterEnd":13,"verseEnd":2},"content":"<p>eat. 12:14; 18:20 the soul. 1:11-13,18,31; 4:17; 10:11; Ps 75:8; 140:11; Jer 25:27-31 Hab 2:8,17; Re 16:6</p>"},{"id":"tsk-pro-13-3","title":"Proverbs 13:3","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":3,"chapterEnd":13,"verseEnd":3},"content":"<p>10:19; 12:13; 21:23; Ps 39:1; Mt 12:36,37; Jas 1:26; 3:2-12</p>"},{"id":"tsk-pro-13-4","title":"Proverbs 13:4","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":4,"chapterEnd":13,"verseEnd":4},"content":"<p>desireth. 10:4; 12:11,24; 26:13; Nu 23:10 but. 2:2-9; 8:34; Joh 6:27; Heb 6:11; 2Pe 1:5-11 made. 11:25; 28:25; Ps 92:14; Isa 58:11</p>"},{"id":"tsk-pro-13-5","title":"Proverbs 13:5","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":5,"chapterEnd":13,"verseEnd":5},"content":"<p>righteous. 6:17; 30:8; Ps 119:163; Eph 4:25; Col 3:9 is. Eze 6:9; 20:43; 36:31; Zec 11:8 and. 3:35; Da 12:2; Re 21:8</p>"},{"id":"tsk-pro-13-6","title":"Proverbs 13:6","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":6,"chapterEnd":13,"verseEnd":6},"content":"<p>Righteousness. 11:3,5,6; Ps 15:2; 25:21; 26:1 wickedness. 5:22; 21:12; 2Ch 28:23; Ps 140:11 the sinner. Heb. sin.</p>"},{"id":"tsk-pro-13-7","title":"Proverbs 13:7","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":7,"chapterEnd":13,"verseEnd":7},"content":"<p>is that maketh himself rich. 11; 12:9; Lu 18:11-14; 1Co 4:8; 2Pe 2:19; Re 3:17 that maketh himself poor. Ec 11:1,2; 1Co 4:10,11; 2Co 4:7; Re 2:9</p>"},{"id":"tsk-pro-13-8","title":"Proverbs 13:8","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":8,"chapterEnd":13,"verseEnd":8},"content":"<p>ransom. 6:35; Ex 21:30; Job 2:4; Ps 49:6-10; Jer 41:8; Mt 16:26 1Pe 1:18,19 the poor. 2Ki 24:14; 25:12; Jer 39:10; Zep 3:12</p>"},{"id":"tsk-pro-13-9","title":"Proverbs 13:9","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":9,"chapterEnd":13,"verseEnd":9},"content":"<p>light. 4:18; 1Ki 11:36; Ps 97:11; 112:4 lamp. or, candle. 20:20; 24:20; Job 18:5,6; 21:17; Isa 50:10,11; Mt 22:13; 25:8</p>"},{"id":"tsk-pro-13-10","title":"Proverbs 13:10","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":10,"chapterEnd":13,"verseEnd":10},"content":"<p>Only. 21:24; Jud 12:1-6; 1Ki 12:10,11,16; 2Ki 14:10; Lu 22:24; 1Ti 6:4 Jas 3:14-16; 4:1,5,6; 3Jo 1:9,10 with. 12:15,16; 17:14; 19:20; 20:18; 25:8; Jud 8:1-3; Lu 14:28-32 Ac 6:1-5</p>"},{"id":"tsk-pro-13-11","title":"Proverbs 13:11","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":11,"chapterEnd":13,"verseEnd":11},"content":"<p>Wealth. 10:2; 20:21; 28:8; Job 15:28,29; 20:15,19-22; 27:16,17; Ec 5:14 Jer 17:11; Hab 2:6,7; Jas 5:1-5 he. 22,23; 20:21; 27:23-27; Ps 128:2 by labour. Heb. with the hand.</p>"},{"id":"tsk-pro-13-12","title":"Proverbs 13:12","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":12,"chapterEnd":13,"verseEnd":12},"content":"<p>Hope. Ps 42:1-3; 69:3; 119:81-83; 143:7; So 5:8 when. 19; Ge 21:6,7; 46:30; 1Sa 1:26-28; Ps 17:15; 40:2,3; Lu 2:29,30 Joh 16:22 a tree. 3:18; 11:30; Re 22:2</p>"},{"id":"tsk-pro-13-13","title":"Proverbs 13:13","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":13,"chapterEnd":13,"verseEnd":13},"content":"<p>despiseth. 1:25,30,31; 2Sa 12:9,10; 2Ch 36:16; Jer 43:2; 44:16,17 Eze 20:13,16,24; Lu 16:31; Heb 10:28,29 he. Ezr 10:3; Ps 115:13; Isa 66:2; Mal 3:16 rewarded. Heb. in peace. Ps 19:11; 119:165; Mt 5:12; 2Jo 1:8</p>"},{"id":"tsk-pro-13-14","title":"Proverbs 13:14","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":14,"chapterEnd":13,"verseEnd":14},"content":"<p>law. 9:11; 10:11; 14:27; 16:22 to. 15:24; 16:6,17; 2Sa 22:6,7; Ps 18:5; 116:3</p>"},{"id":"tsk-pro-13-15","title":"Proverbs 13:15","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":15,"chapterEnd":13,"verseEnd":15},"content":"<p>Good. 3:4; 14:35; 1Sa 18:14-16; Lu 2:52; Ac 7:10 but. 4:19; 15:10; Ps 95:9-11; Jer 2:19; Ro 6:21</p>"},{"id":"tsk-pro-13-16","title":"Proverbs 13:16","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":16,"chapterEnd":13,"verseEnd":16},"content":"<p>prudent. 12:22,23; 15:2; 21:24; Ps 112:5; Isa 52:13; Mt 10:16; Ro 16:19 1Co 14:20; Eph 5:17 a fool. 1Sa 25:10,11,17,25; Ec 10:3 layeth. Heb. spreadeth.</p>"},{"id":"tsk-pro-13-17","title":"Proverbs 13:17","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":17,"chapterEnd":13,"verseEnd":17},"content":"<p>wicked. 10:26; 26:6; Jer 23:13-16,28; Eze 3:18; 33:7,8; 2Co 2:17 but. 25:13,23; 1Co 4:2; 2Co 5:20; 1Ti 1:12; 2Ti 2:2 a faithful ambassador. Heb. an ambassador of faithfulness.</p>"},{"id":"tsk-pro-13-18","title":"Proverbs 13:18","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":18,"chapterEnd":13,"verseEnd":18},"content":"<p>Poverty. 13; 5:9-14; 12:1; 15:5,31,32; 19:6; Jer 5:3-9; Heb 12:25 he. 9:9; 25:12; Ps 141:5</p>"},{"id":"tsk-pro-13-19","title":"Proverbs 13:19","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":19,"chapterEnd":13,"verseEnd":19},"content":"<p>The desire. 12; 1Ki 1:48; Ps 21:1,2; So 3:4; 2Ti 4:7,8; Re 7:14-17 it is. 29:27 depart. 3:7; 16:6,17; Job 28:28; Ps 34:14; 37:27; 2Ti 2:19</p>"},{"id":"tsk-pro-13-20","title":"Proverbs 13:20","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":20,"chapterEnd":13,"verseEnd":20},"content":"<p>that. 2:20; Ps 119:63; So 1:7,8; Mal 3:16; Ac 2:42; Heb 10:24 but. 1:11-19; 2:12-19; 7:22,23,27; 9:6; Ge 13:12,13; 14:12; 1Ki 12:8,10 1Ki 22:4,32; 2Ch 19:2; 1Co 15:33,34; 2Co 6:14-18; Re 18:4 destroyed. Heb. broken.</p>"},{"id":"tsk-pro-13-21","title":"Proverbs 13:21","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":21,"chapterEnd":13,"verseEnd":21},"content":"<p>pursueth. Ge 4:7; Nu 32:23; Ps 32:10; 140:11; Ac 28:4 righteous. Isa 3:10,11; Ro 2:7-10</p>"},{"id":"tsk-pro-13-22","title":"Proverbs 13:22","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":22,"chapterEnd":13,"verseEnd":22},"content":"<p>leaveth. Ge 17:7,8; Ps 25:12,13; 102:28; 112:2; 128:6 the wealth. 28:8; Job 27:16,17; Ec 2:26</p>"},{"id":"tsk-pro-13-23","title":"Proverbs 13:23","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":23,"chapterEnd":13,"verseEnd":23},"content":"<p>food. 12:11,14; 27:18,23-27; 28:19; Ec 5:9 destroyed. 6:6-11; 11:5,6; Ps 112:5; Ec 8:5,6; Jer 8:7-10</p>"},{"id":"tsk-pro-13-24","title":"Proverbs 13:24","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":24,"chapterEnd":13,"verseEnd":24},"content":"<p>3:12; 8:36; 19:18; 22:15; 23:13,14; 29:15,17; Lu 14:26; Heb 12:6-8</p>"},{"id":"tsk-pro-13-25","title":"Proverbs 13:25","author":"R. A. Torrey (editor)","reference":{"book":"PRO","chapterStart":13,"verseStart":25,"chapterEnd":13,"verseEnd":25},"content":"<p>righteous. Ps 34:10; 37:3,16,18,19; 1Ti 4:8; Heb 13:5 the belly. 6:11; 24:34; De 28:48; 32:24; Isa 65:13,14; 2Th 3:10</p>"}]}