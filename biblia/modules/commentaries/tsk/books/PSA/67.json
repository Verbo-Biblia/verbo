{"entries":[{"id":"tsk-psa-67-1","title":"Psalms 67:1","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":67,"verseStart":1,"chapterEnd":67,"verseEnd":1},"content":"<p>1 A prayer for the enlargement of God's kingdom; 3 to the joy of the people; 6 and the increase of God's blessings.</p>\n<p>A.M. cir. 3464. B.C. cir. 540. (Title.) Neginoth. 4:1; 6:1; 76:1; *titles God. Nu 6:24-27; De 21:8; 2Co 13:14 bless us. 28:9; Eph 1:3 cause. 4:6; 31:16; 80:1-3,7,19; 119:135; 2Co 4:6 upon us. Heb. with us.</p>"},{"id":"tsk-psa-67-2","title":"Psalms 67:2","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":67,"verseStart":2,"chapterEnd":67,"verseEnd":2},"content":"<p>That. 98:2,3; Es 8:15-17; Zec 8:20-23; Ac 9:31 thy way. Ac 13:10; 18:25; 22:4 saving. 43:5; 66:1-4; 117:2; Isa 49:6; Mt 28:19; Lu 2:30,31; 3:6; Tit 2:11</p>"},{"id":"tsk-psa-67-3","title":"Psalms 67:3","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":67,"verseStart":3,"chapterEnd":67,"verseEnd":3},"content":"<p>5; 45:17; 74:21; 119:175; 142:7; Isa 38:18,19</p>"},{"id":"tsk-psa-67-4","title":"Psalms 67:4","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":67,"verseStart":4,"chapterEnd":67,"verseEnd":4},"content":"<p>O let. 97:1; 138:4,5; De 32:43; Isa 24:14-16; 42:10-12; 54:1; Ro 15:10,11 Ga 4:27 for thou. 9:8; 96:10-13; 98:9; Ge 18:25; Ac 17:31; Ro 2:5 govern. Heb. lead. 2:8; 82:6; Isa 55:4; Re 11:15-17</p>"},{"id":"tsk-psa-67-5","title":"Psalms 67:5","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":67,"verseStart":5,"chapterEnd":67,"verseEnd":5},"content":"<p>3; Mt 6:9,10</p>"},{"id":"tsk-psa-67-6","title":"Psalms 67:6","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":67,"verseStart":6,"chapterEnd":67,"verseEnd":6},"content":"<p>Then. 85:9-12; Le 26:4; Isa 1:19; 30:23,24; Eze 34:26,27; Ho 2:21,22 1Co 3:6-9 our own. 48:14; Ge 17:7; Ex 3:15; Jer 31:1,33</p>"},{"id":"tsk-psa-67-7","title":"Psalms 67:7","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":67,"verseStart":7,"chapterEnd":67,"verseEnd":7},"content":"<p>God. 29:11; 72:17; Ge 12:2,3; Ac 2:28; Ga 3:9,14 all the. 22:27; 65:5; 98:3; Isa 43:6; 45:22; 52:10; Mic 5:4; Zec 9:10 Mal 1:11; Ac 13:47; Re 15:4 fear. Mal 4:2; Ac 13:26</p>"}]}