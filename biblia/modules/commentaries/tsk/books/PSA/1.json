{"entries":[{"id":"tsk-psa-1-intro","title":"Psalms 1 — Chapter Introduction","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":1,"verseStart":0,"chapterEnd":1,"verseEnd":0},"content":"<p>he is. 26:12; Ex 5:2; Ps 73:6,10; Isa 28:1; Eze 29:3; Re 12:1-3; 13:2 Re 20:2,3</p>"},{"id":"tsk-psa-1-1","title":"Psalms 1:1","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":1,"verseStart":1,"chapterEnd":1,"verseEnd":1},"content":"<p>1 The happiness of the godly. 4 The unhappiness of the ungodly.</p>\n<p>A.M. 3560. B.C. 444. Blessed. 2:12; 32:1,2; 34:8; 84:12; 106:3; 112:1; 115:12-15; 119:1,2; 144:15 146:5; De 28:2-68; 33:29; Jer 17:7; Mt 16:17; Lu 11:28; Joh 13:17 Joh 20:29; Re 22:14 walketh. 81:12; Ge 5:24; Le 26:27,28; 1Ki 16:31; Job 31:5; Pr 1:15; 4:14,15 Pr 13:20; Eze 20:18; 1Pe 4:3 counsel. 64:2; Ge 49:6; 2Ch 22:3; Job 10:3; 21:16; Lu 23:51 ungodly. or, wicked. standeth. 26:12; Ro 5:2; Eph 6:13 way. 6; 36:4; 146:9; Pr 2:12; 4:19; 13:15; Mt 7:13,14 sitteth. 26:4,5; 119:115; Jer 15:17 scornful. Pr 1:22; 3:34; 9:12; 19:29</p>"},{"id":"tsk-psa-1-2","title":"Psalms 1:2","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":1,"verseStart":2,"chapterEnd":1,"verseEnd":2},"content":"<p>But his. 40:8; 112:1; 119:11,35,47,48,72,92; Job 23:12; Jer 15:16; Ro 7:22 1Jo 5:3 meditate. 104:34; 119:11,15,97-99; Jos 1:8; 1Ti 4:15 day. 88:1; Lu 2:37; 18:7; 1Th 2:9; 2Ti 1:3</p>"},{"id":"tsk-psa-1-3","title":"Psalms 1:3","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":1,"verseStart":3,"chapterEnd":1,"verseEnd":3},"content":"<p>tree. Job 14:9; Isa 44:4; Jer 17:8; Eze 17:8; 19:10; 47:12; Re 22:2 bringeth. 92:14; Mt 21:34,41 shall not. Isa 27:11; Mt 13:6; 21:19; Joh 15:6; Jude 1:12 wither. Heb. fade. whatsoever. 128:2; 129:8; Ge 39:3,23; Jos 1:7,8; 1Ch 22:11; 2Ch 31:21; 32:23 Isa 3:10</p>"},{"id":"tsk-psa-1-4","title":"Psalms 1:4","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":1,"verseStart":4,"chapterEnd":1,"verseEnd":4},"content":"<p>like. 35:5; Job 21:18; Isa 17:13; 29:5; Ho 13:3; Mt 3:12</p>"},{"id":"tsk-psa-1-5","title":"Psalms 1:5","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":1,"verseStart":5,"chapterEnd":1,"verseEnd":5},"content":"<p>shall. 5:5; 24:3; Lu 21:36; Jude 1:15 sinners. 26:9; Mal 3:18; Mt 13:49; 25:32,41,46</p>"},{"id":"tsk-psa-1-6","title":"Psalms 1:6","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":1,"verseStart":6,"chapterEnd":1,"verseEnd":6},"content":"<p>knoweth. 37:18-24; 139:1,2; 142:3; Job 23:10; Na 1:7; Joh 10:14,27; 2Ti 2:19 way. 112:10; 146:9; Pr 14:12; 15:9; Mt 7:13; 2Pe 2:12</p>"}]}