{"entries":[{"id":"tsk-psa-13-1","title":"Psalms 13:1","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":13,"verseStart":1,"chapterEnd":13,"verseEnd":1},"content":"<p>1 David complains of delay. 3 He prays for preventing grace. 5 He boasts of divine mercy.</p>\n<p>A.M. 3464. B.C. 540. (Title.) chief. or, overseer. How. 6:3; 35:17; 74:1; 80:4; 85:5; 89:46; 90:14; 94:3,4 forget. 10:12; La 5:20 wilt thou hide. 22:1,2; De 31:17; Job 13:24; Isa 59:2</p>"},{"id":"tsk-psa-13-2","title":"Psalms 13:2","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":13,"verseStart":2,"chapterEnd":13,"verseEnd":2},"content":"<p>take. 77:2-12; 94:18,19; 142:4-7; Job 7:12-15; 9:19-21,27,28; 10:15 Job 23:8-10; Jer 15:18 sorrow. 38:17; 116:3; Ne 2:2; Pr 15:13; Ec 5:17; Jer 8:18; 45:3; Mt 26:38 Joh 16:6; Ro 9:2; Php 2:27 enemy. 7:2,4,5; 8:2; 9:6; 10:18; 17:9; 74:10,18; 1Sa 18:29; 24:19; Es 7:6 La 1:9; Mic 7:8-10 exalted. 22:7,8; 31:18; 42:10; 44:14-16; 123:3,4; 143:3,4; La 1:5; Lu 22:53</p>"},{"id":"tsk-psa-13-3","title":"Psalms 13:3","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":13,"verseStart":3,"chapterEnd":13,"verseEnd":3},"content":"<p>Consider. 9:13; 25:19; 31:7; 119:153; La 5:1 lighten. 18:28; 1Sa 14:27,29; Ezr 9:8; Lu 2:32; Re 21:23 less. Jer 51:39,57; Eph 5:14</p>"},{"id":"tsk-psa-13-4","title":"Psalms 13:4","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":13,"verseStart":4,"chapterEnd":13,"verseEnd":4},"content":"<p>Lest. 10:11; 25:2; 35:19,25; 38:16; Jos 7:9; Eze 35:12-15 I have. 9:19; Jer 1:19; La 1:16 when. 55:22; 62:2,6; 112:6; 121:1-3; Pr 12:3</p>"},{"id":"tsk-psa-13-5","title":"Psalms 13:5","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":13,"verseStart":5,"chapterEnd":13,"verseEnd":5},"content":"<p>But. 32:10; 33:18,21,22; 36:7; 52:8; 147:11; Isa 12:2; Jude 1:21 my heart. 9:14; 43:4,5; 51:12; 119:81; 1Sa 2:1; Hab 3:18; Lu 1:47; 2:20</p>"},{"id":"tsk-psa-13-6","title":"Psalms 13:6","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":13,"verseStart":6,"chapterEnd":13,"verseEnd":6},"content":"<p>I. 21:13 he. 116:7; 119:7</p>"}]}