{"entries":[{"id":"tsk-psa-54-1","title":"Psalms 54:1","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":54,"verseStart":1,"chapterEnd":54,"verseEnd":1},"content":"<p>1 David, complaining of the Ziphims, prays for salvation. 4 Upon his confidence in God's help he promises sacrifice.</p>\n<p>A.M. 2943. B.C. 1061. (Title.) Ziphims. 1Sa 23:19,20; 26:1; Mic 7:5,6; Mt 10:21 by the name. 20:1; 48:10; 79:9; Ex 3:14,15; 23:21; 34:5,6; Pr 18:10; Isa 30:27 Mt 1:21,23; Ac 4:12 judge. 26:1; 43:1,2; 99:4; Pr 23:11; Jer 50:34</p>"},{"id":"tsk-psa-54-2","title":"Psalms 54:2","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":54,"verseStart":2,"chapterEnd":54,"verseEnd":2},"content":"<p>5:1-3; 13:3; 55:1,2; 130:2; 143:7</p>"},{"id":"tsk-psa-54-3","title":"Psalms 54:3","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":54,"verseStart":3,"chapterEnd":54,"verseEnd":3},"content":"<p>strangers. 69:8; 86:14; Job 19:13-15 oppressors. 22:16; 59:3-5; Mt 27:20-23 they have. 16:8; 36:1; 53:4; Joh 16:3</p>"},{"id":"tsk-psa-54-4","title":"Psalms 54:4","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":54,"verseStart":4,"chapterEnd":54,"verseEnd":4},"content":"<p>118:6,7,13; 1Ch 12:18; Isa 41:10; 42:1; 50:7-9; Ro 8:31; Heb 13:6</p>"},{"id":"tsk-psa-54-5","title":"Psalms 54:5","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":54,"verseStart":5,"chapterEnd":54,"verseEnd":5},"content":"<p>reward. 31:23; 137:8; 2Ti 4:14; Re 18:6 mine enemies. Heb. those that observe me. 5:8; 27:11; *marg: cut. 89:49; 143:1,12</p>"},{"id":"tsk-psa-54-6","title":"Psalms 54:6","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":54,"verseStart":6,"chapterEnd":54,"verseEnd":6},"content":"<p>freely. 66:13-16; 107:22; 116:17; De 12:6,7 praise. 7:17; 21:13; 140:13 for it. 52:9; 92:1; 147:1</p>"},{"id":"tsk-psa-54-7","title":"Psalms 54:7","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":54,"verseStart":7,"chapterEnd":54,"verseEnd":7},"content":"<p>For he. 34:19; Ge 48:16; 1Sa 26:24; 2Sa 4:9; 2Ti 4:18 and mine. 37:34; 58:10,11; 59:10; 91:8; 92:11; 112:8</p>"}]}