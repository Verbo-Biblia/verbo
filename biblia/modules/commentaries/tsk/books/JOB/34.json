{"entries":[{"id":"tsk-job-34-1","title":"Job 34:1","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":1,"chapterEnd":34,"verseEnd":1},"content":"<p>1 Elihu accuses Job for charging God with injustice. 10 God omnipotent cannot be unjust. 31 Man must humble himself unto God. 34 Elihu reproves Job.</p>"},{"id":"tsk-job-34-2","title":"Job 34:2","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":2,"chapterEnd":34,"verseEnd":2},"content":"<p>Pr 1:5; 1Co 10:15; 14:20</p>"},{"id":"tsk-job-34-3","title":"Job 34:3","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":3,"chapterEnd":34,"verseEnd":3},"content":"<p>the ear. 6:30; 12:11; 1Co 2:15; Heb 5:14 mouth. Heb. palate. 31:30; 33:2; *marg:</p>"},{"id":"tsk-job-34-4","title":"Job 34:4","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":4,"chapterEnd":34,"verseEnd":4},"content":"<p>choose. 36; Jud 19:30; 20:7; 1Co 6:2-5; Ga 2:11-14; 1Th 5:21 know. Isa 11:2-5; Joh 7:24; Ro 12:2</p>"},{"id":"tsk-job-34-5","title":"Job 34:5","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":5,"chapterEnd":34,"verseEnd":5},"content":"<p>I. 10:7; 11:4; 16:17; 29:14; 32:1; 33:9 God. 9:17; 27:2</p>"},{"id":"tsk-job-34-6","title":"Job 34:6","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":6,"chapterEnd":34,"verseEnd":6},"content":"<p>I. 27:4-6 wound. Heb. arrow. 6:4; 16:13</p>"},{"id":"tsk-job-34-7","title":"Job 34:7","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":7,"chapterEnd":34,"verseEnd":7},"content":"<p>15:16; De 29:19; Pr 1:22; 4:17</p>"},{"id":"tsk-job-34-8","title":"Job 34:8","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":8,"chapterEnd":34,"verseEnd":8},"content":"<p>2:10; 11:3; 15:5; Ps 1:1; 26:4; 50:18; 73:12-15; Pr 1:15; 2:12; 4:14 Pr 13:20; 1Co 15:33</p>"},{"id":"tsk-job-34-9","title":"Job 34:9","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":9,"chapterEnd":34,"verseEnd":9},"content":"<p>It. 9:22,23,30,31; 21:14-16,30; 22:17; 35:3; Mal 3:14 delight. 27:10; Ps 37:4</p>"},{"id":"tsk-job-34-10","title":"Job 34:10","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":10,"chapterEnd":34,"verseEnd":10},"content":"<p>understanding. Heb. heart. 2,3,34; Pr 6:32; 15:32; *marg: far. 8:3; 36:23; 37:23; Ge 18:25; De 32:4; 2Ch 19:7; Ps 92:15; Jer 12:1 Ro 3:4,5; 9:14; Jas 1:13</p>"},{"id":"tsk-job-34-11","title":"Job 34:11","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":11,"chapterEnd":34,"verseEnd":11},"content":"<p>the work. 33:26; Ps 62:12; Pr 24:12; Jer 32:19; Eze 33:17-20; Mt 16:27 Ro 2:6; 2Co 5:10; 1Pe 1:17; Re 22:12 cause. Pr 1:31; Ga 6:7,8</p>"},{"id":"tsk-job-34-12","title":"Job 34:12","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":12,"chapterEnd":34,"verseEnd":12},"content":"<p>surely. Ps 11:7; 145:17; Hab 1:12,13 pervert. 8:3</p>"},{"id":"tsk-job-34-13","title":"Job 34:13","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":13,"chapterEnd":34,"verseEnd":13},"content":"<p>Who hath given. 36:23; 38:4-41; 40:8-11; 1Ch 29:11; Pr 8:23-30; Isa 40:13,14 Da 4:35; Ro 11:34-36 the whole world. Heb. the world, all of it.</p>"},{"id":"tsk-job-34-14","title":"Job 34:14","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":14,"chapterEnd":34,"verseEnd":14},"content":"<p>set. 7:17; 9:4 upon man. Heb. upon him. he gather. Ps 104:29; Isa 24:22</p>"},{"id":"tsk-job-34-15","title":"Job 34:15","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":15,"chapterEnd":34,"verseEnd":15},"content":"<p>30:23; Ge 3:19; Ps 90:3-10; Ec 12:7; Isa 27:4; 57:16</p>"},{"id":"tsk-job-34-16","title":"Job 34:16","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":16,"chapterEnd":34,"verseEnd":16},"content":"<p>12:3; 13:2-6</p>"},{"id":"tsk-job-34-17","title":"Job 34:17","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":17,"chapterEnd":34,"verseEnd":17},"content":"<p>even. Ge 18:25; 2Sa 23:3; Ro 3:5-7 govern. Heb. bind. wilt. 1:22; 40:8; 2Sa 19:21; Ro 9:14</p>"},{"id":"tsk-job-34-18","title":"Job 34:18","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":18,"chapterEnd":34,"verseEnd":18},"content":"<p>Ex 22:28; Pr 17:26; Ac 23:3,5; Ro 13:7; 1Pe 2:17; 2Pe 2:10; Jude 1:8</p>"},{"id":"tsk-job-34-19","title":"Job 34:19","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":19,"chapterEnd":34,"verseEnd":19},"content":"<p>accepteth. 13:8; De 10:17; 2Ch 19:7; Ac 10:34; Ro 2:11; Ga 2:6; Eph 6:9 Col 3:25; 1Pe 1:17; Heb 12:28 princes. 12:19,21; Ps 2:2-4; Ec 5:8; Isa 3:14 regardeth. 36:19; Ps 49:6,7; Jas 2:5 they. 31:15; Pr 14:31; 22:2</p>"},{"id":"tsk-job-34-20","title":"Job 34:20","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":20,"chapterEnd":34,"verseEnd":20},"content":"<p>a moment. Ps 73:19; Isa 30:13; 37:38; Da 5:30; Lu 12:20; Ac 12:23; 1Th 5:2 2Pe 2:3 troubled. Ex 12:29,30; Isa 37:36; Mt 25:6; Lu 17:26-29 the mighty shall be taken away. Heb. they shall take awaythe mighty. without. 1Sa 25:37-39; 26:10; Isa 10:16-19; 30:30-33; Da 2:34,44,45 Zec 4:6</p>"},{"id":"tsk-job-34-21","title":"Job 34:21","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":21,"chapterEnd":34,"verseEnd":21},"content":"<p>31:4; Ge 16:13; 2Ch 16:9; Ps 34:15; 139:23; Pr 5:21; 15:3; Jer 16:17 Jer 17:10; 32:19; Am 9:8</p>"},{"id":"tsk-job-34-22","title":"Job 34:22","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":22,"chapterEnd":34,"verseEnd":22},"content":"<p>no. Ps 139:11,12; Isa 29:15; Jer 23:24; Am 9:2,3; 1Co 4:5; Heb 4:13 Re 6:15,16 nor. 3:5; 24:17; Isa 9:2 the. 31:3; Ps 5:5; Pr 10:29; Mt 7:23; Lu 13:27</p>"},{"id":"tsk-job-34-23","title":"Job 34:23","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":23,"chapterEnd":34,"verseEnd":23},"content":"<p>he will. 10-12; 11:6; Ezr 9:13; Ps 119:137; Isa 42:3; Da 9:7-9 that he. 9:32,33; 16:21; 23:7; Jer 2:5; Ro 9:20 enter. Heb. go.</p>"},{"id":"tsk-job-34-24","title":"Job 34:24","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":24,"chapterEnd":34,"verseEnd":24},"content":"<p>break. 19:2; Ps 2:9; 72:4; 94:5; Jer 51:20-23; Da 2:21,34,35,44,45 number. Heb. searching out. set. 1Sa 2:30-36; 15:28; 1Ki 14:7,8,14; Ps 113:7,8; Da 5:28-31</p>"},{"id":"tsk-job-34-25","title":"Job 34:25","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":25,"chapterEnd":34,"verseEnd":25},"content":"<p>he knoweth. Ps 33:15; Isa 66:18; Ho 7:2; Am 8:7; Re 20:12 in the. 20; So 3:8; Isa 15:1; 1Th 5:2 destroyed. Heb. crushed.</p>"},{"id":"tsk-job-34-26","title":"Job 34:26","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":26,"chapterEnd":34,"verseEnd":26},"content":"<p>in. Ex 14:30; De 13:9-11; 21:21; 2Sa 12:11,12; Ps 58:10,11; Isa 66:24 1Ti 5:20,24; Re 18:9,10,20 open sight of others. Heb. place of beholders.</p>"},{"id":"tsk-job-34-27","title":"Job 34:27","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":27,"chapterEnd":34,"verseEnd":27},"content":"<p>turned. 1Sa 15:11; Ps 125:5; Zep 1:6; Lu 17:31,32; Ac 15:38; 2Ti 4:10 Heb 10:39 from him. Heb. from after him. would. Ps 28:5; 107:43; Pr 1:29,30; Isa 1:3; 5:12; Hag 2:15-19</p>"},{"id":"tsk-job-34-28","title":"Job 34:28","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":28,"chapterEnd":34,"verseEnd":28},"content":"<p>they. 22:9,10; 24:12; 29:12,13; 31:19,20; 35:9; Ex 2:23,24; 3:7,9; Ps 12:5 Isa 5:7; Jas 5:4 and he. Ex 22:23-27</p>"},{"id":"tsk-job-34-29","title":"Job 34:29","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":29,"chapterEnd":34,"verseEnd":29},"content":"<p>When he giveth. 29:1-3; 2Sa 7:1; Isa 14:3-8; 26:3; 32:17; Joh 14:27; Ro 8:31-34 Php 4:7 when he hideth. 23:8,9; Ps 13:1; 27:9; 30:7; 143:7 who then can behold. 12:14; 23:13 whether. 2Ki 18:9-12; 2Ch 36:14-17; Jer 27:8</p>"},{"id":"tsk-job-34-30","title":"Job 34:30","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":30,"chapterEnd":34,"verseEnd":30},"content":"<p>21; 1Ki 12:28-30; 2Ki 21:9; Ps 12:8; Ec 9:18; Ho 5:11; 13:11 Mic 6:16; 2Th 2:4-11; Re 13:3,4,11-14</p>"},{"id":"tsk-job-34-31","title":"Job 34:31","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":31,"chapterEnd":34,"verseEnd":31},"content":"<p>33:27; 40:3-5; 42:6; Le 26:41; Ezr 9:13,14; Ne 9:33-38 Jer 31:18,19; Da 9:7-14; Mic 7:9</p>"},{"id":"tsk-job-34-32","title":"Job 34:32","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":32,"chapterEnd":34,"verseEnd":32},"content":"<p>which. 10:2; Ps 19:12; 25:4,5; 32:8; 139:23,24; 143:8-10 if. Pr 28:13; Lu 3:8-14; Eph 4:22,25-28</p>"},{"id":"tsk-job-34-33","title":"Job 34:33","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":33,"chapterEnd":34,"verseEnd":33},"content":"<p>Should. 9:12; 18:4; Isa 45:9; Ro 9:20; 11:35 according to thy mind. Heb. from with thee. he will. 11; 15:31; Ps 89:30-32; Pr 11:31; 2Th 1:6,7; Heb 2:2; 11:26 whether thou refuse. Ps 135:6; Mt 20:12-15 what. 33:5,32</p>"},{"id":"tsk-job-34-34","title":"Job 34:34","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":34,"chapterEnd":34,"verseEnd":34},"content":"<p>understanding. Heb. heart. 2,4,10,16; 1Co 10:15</p>"},{"id":"tsk-job-34-35","title":"Job 34:35","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":35,"chapterEnd":34,"verseEnd":35},"content":"<p>13:2; 15:2; 35:16; 38:2; 42:3</p>"},{"id":"tsk-job-34-36","title":"Job 34:36","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":36,"chapterEnd":34,"verseEnd":36},"content":"<p>My desire is that Job may be tried. or, My father, let Jobbe tried. 23:16; Ps 17:3; 26:2; Jas 5:11 his answers. 8,9; 12:6; 21:7; 24:1</p>"},{"id":"tsk-job-34-37","title":"Job 34:37","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":34,"verseStart":37,"chapterEnd":34,"verseEnd":37},"content":"<p>rebellion. 1Sa 15:23; Isa 1:19,20 he clappeth. 27:23 multiplieth. 8:2,3; 11:2,3; 35:2,3,16; 42:7</p>"}]}