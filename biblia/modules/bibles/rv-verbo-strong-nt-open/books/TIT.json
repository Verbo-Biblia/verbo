"morph":"T-ASF"},{"text":"verdad.","strong":"G225","morph":"N-ASF"}],"strongs":["G225","G444","G2532","G3361","G3588"]},"15":{"text":"Todas las cosas son limpias a los limpios; pero a los contaminados e infieles nada es limpio: antes su alma y conciencia están contaminadas.","segments":[{"text":"Todas"},{"text":"las"},{"text":"cosas"},{"text":"son"},{"text":"limpias","strong":"G2513","morph":"A-NPN"},{"text":"a"},{"text":"los"},{"text":"limpios;","strong":"G2513","morph":"A-DPM"},{"text":"pero","strong":"G1161","morph":"CONJ"},{"text":"a"},{"text":"los"},{"text":"contaminados"},{"text":"e"},{"text":"infieles"},{"text":"nada","strong":"G3762","morph":"A-NSN"},{"text":"es"},{"text":"limpio:","strong":"G2513","morph":"A-NSN"},{"text":"antes"},{"text":"su"},{"text":"alma"},{"text":"y"},{"text":"conciencia","strong":"G4893","morph":"N-NSF"},{"text":"están"},{"text":"contaminadas."}],"strongs":["G1161","G2513","G3762","G4893"]},"16":{"text":"Profésanse conocer a Dios; pero con los hechos lo niegan, siendo abominables y rebeldes, reprobados para toda buena obra.","segments":[{"text":"Profésanse"},{"text":"conocer"},{"text":"a"},{"text":"Dios;","strong":"G2316","morph":"N-ASM-T"},{"text":"pero","strong":"G1161","morph":"CONJ"},{"text":"con"},{"text":"los"},{"text":"hechos"},{"text":"lo"},{"text":"niegan,"},{"text":"siendo"},{"text":"abominables"},{"text":"y"},{"text":"rebeldes,"},{"text":"reprobados","strong":"G96","morph":"A-NPM"},{"text":"para"},{"text":"toda","strong":"G3956","morph":"A-ASN"},{"text":"buena","strong":"G18","morph":"A-ASN"},{"text":"obra.","strong":"G2041","morph":"N-ASN"}],"strongs":["G18","G96","G1161","G2041","G2316","G3956"]}},"2":{"1":{"text":"Pero tú, habla lo que conviene a la sana doctrina:","segments":[{"text":"Pero","strong":"G1161","morph":"CONJ"},{"text":"tú,","strong":"G4771","morph":"P-2NS"},{"text":"habla"},{"text":"lo"},{"text":"que"},{"text":"conviene"},{"text":"a"},{"text":"la","strong":"G3588","morph":"T-DSF"},{"text":"sana"},{"text":"doctrina:"}],"strongs":["G1161","G3588","G4771"]},"2":{"text":"Que los viejos sean templados, graves, prudentes, sanos en la fe, en la caridad, en la paciencia.","segments":[{"text":"Que"},{"text":"los"},{"text":"viejos"},{"text":"sean"},{"text":"templados,"},{"text":"graves,"},{"text":"prudentes,"},{"text":"sanos"},{"text":"en"},{"text":"la"},{"text":"fe,"},{"text":"en"},{"text":"la"},{"text":"caridad,"},{"text":"en"},{"text":"la"},{"text":"paciencia."}],"strongs":[]},"3":{"text":"Las viejas, asimismo, se distingan en un porte santo; no calumniadoras, no dadas a mucho vino, maestras de honestidad:","segments":[{"text":"Las"},{"text":"viejas,"},{"text":"asimismo,"},{"text":"se"},{"text":"distingan"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"un"},{"text":"porte"},{"text":"santo;"},{"text":"no"},{"text":"calumniadoras,","strong":"G1228","morph":"A-APF"},{"text":"no"},{"text":"dadas"},{"text":"a"},{"text":"mucho","strong":"G4183","morph":"A-DSM"},{"text":"vino,"},{"text":"maestras"},{"text":"de"},{"text":"honestidad:"}],"strongs":["G1228","G1722","G4183"]},"4":{"text":"Que enseñen a las mujeres jóvenes a ser prudentes, a que amen a sus maridos, a que amen a sus hijos,","segments":[{"text":"Que"},{"text":"enseñen"},{"text":"a"},{"text":"las","strong":"G3588","morph":"T-APF"},{"text":"mujeres","strong":"G3501","morph":"A-APF"},{"text":"jóvenes"},{"text":"a"},{"text":"ser"},{"text":"prudentes,"},{"text":"a"},{"text":"que"},{"text":"amen"},{"text":"a"},{"text":"sus"},{"text":"maridos,"},{"text":"a"},{"text":"que"},{"text":"amen"},{"text":"a"},{"text":"sus"},{"text":"hijos,"}],"strongs":["G3501","G3588"]},"5":{"text":"A ser templadas, castas, que tengan cuidado de la casa, buenas, sujetas a sus maridos; porque la palabra de Dios no sea blasfemada.","segments":[{"text":"A"},{"text":"ser"},{"text":"templadas,"},{"text":"castas,"},{"text":"que"},{"text":"tengan"},{"text":"cuidado"},{"text":"de"},{"text":"la"},{"text":"casa,"},{"text":"buenas,","strong":"G18","morph":"A-APF"},{"text":"sujetas"},{"text":"a"},{"text":"sus"},{"text":"maridos;"},{"text":"porque"},{"text":"la"},{"text":"palabra","strong":"G3056","morph":"N-NSM"},{"text":"de"},{"text":"Dios","strong":"G2316","morph":"N-GSM-T"},{"text":"no","strong":"G3361","morph":"PRT-N"},{"text":"sea"},{"text":"blasfemada."}],"strongs":["G18","G2316","G3056","G3361"]},"6":{"text":"Exhorta asimismo a los mancebos a que sean comedidos;","segments":[{"text":"Exhorta"},{"text":"asimismo"},{"text":"a"},{"text":"los","strong":"G3588","morph":"T-APM"},{"text":"mancebos"},{"text":"a"},{"text":"que"},{"text":"sean"},{"text":"comedidos;"}],"strongs":["G3588"]},"7":{"text":"Mostrándote en todo por ejemplo de buenas obras; en doctrina haciendo ver integridad, gravedad,","segments":[{"text":"Mostrándote"},{"text":"en"},{"text":"todo"},{"text":"por"},{"text":"ejemplo"},{"text":"de"},{"text":"buenas"},{"text":"obras;","strong":"G2041","morph":"N-GPN"},{"text":"en"},{"text":"doctrina"},{"text":"haciendo"},{"text":"ver"},{"text":"integridad,"},{"text":"gravedad,"}],"strongs":["G2041"]},"8":{"text":"Palabra sana, e irreprensible; que el adversario se avergüence, no teniendo mal ninguno que decir de ustedes.","segments":[{"text":"Palabra","strong":"G3056","morph":"N-ASM"},{"text":"sana,"},{"text":"e"},{"text":"irreprensible;"},{"text":"que"},{"text":"el","strong":"G3588","morph":"T-NSM"},{"text":"adversario"},{"text":"se"},{"text":"avergüence,"},{"text":"no"},{"text":"teniendo"},{"text":"mal"},{"text":"ninguno"},{"text":"que"},{"text":"decir"},{"text":"de"},{"text":"ustedes."}],"strongs":["G3056","G3588"]},"9":{"text":"Exhorta a los siervos a que sean sujetos a sus señores, que agraden en todo, no respondones;","segments":[{"text":"Exhorta"},{"text":"a"},{"text":"los"},{"text":"siervos"},{"text":"a"},{"text":"que"},{"text":"sean"},{"text":"sujetos"},{"text":"a"},{"text":"sus"},{"text":"señores,"},{"text":"que"},{"text":"agraden"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"todo,"},{"text":"no","strong":"G3361","morph":"PRT-N"},{"text":"respondones;"}],"strongs":["G1722","G3361"]},"10":{"text":"No defraudando, antes mostrando toda buena lealtad, para que adornen en todo la doctrina de nuestro Salvador Dios.","segments":[{"text":"No","strong":"G3361","morph":"PRT-N"},{"text":"defraudando,"},{"text":"antes"},{"text":"mostrando"},{"text":"toda"},{"text":"buena","strong":"G18","morph":"A-ASF"},{"text":"lealtad,"},{"text":"para"},{"text":"que","strong":"G2443","morph":"CONJ"},{"text":"adornen"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"todo"},{"text":"la"},{"text":"doctrina"},{"text":"de"},{"text":"nuestro","strong":"G3165","morph":"P-1GP"},{"text":"Salvador","strong":"G4990","morph":"N-GSM"},{"text":"Dios.","strong":"G2316","morph":"N-GSM-T"}],"strongs":["G18","G1722","G2316","G2443","G3165","G3361","G4990"]},"11":{"text":"Porque la gracia de Dios que trae salvación a todos los hombres, se manifestó,","segments":[{"text":"Porque","strong":"G1063","morph":"CONJ"},{"text":"la"},{"text":"gracia"},{"text":"de"},{"text":"Dios","strong":"G2316","morph":"N-GSM-T"},{"text":"que"},{"text":"trae"},{"text":"salvación"},{"text":"a"},{"text":"todos"},{"text":"los"},{"text":"hombres,","strong":"G444","morph":"N-DPM"},{"text":"se"},{"text":"manifestó,"}],"strongs":["G444","G1063","G2316"]},"12":{"text":"Enseñándonos que, renunciando a la impiedad y a los deseos mundanos, vivamos en este siglo templada, y justa, y píamente,","segments":[{"text":"Enseñándonos"},{"text":"que,"},{"text":"renunciando"},{"text":"a"},{"text":"la","strong":"G3588","morph":"T-ASF"},{"text":"impiedad"},{"text":"y"},{"text":"a"},{"text":"los","strong":"G3588","morph":"T-APF"},{"text":"deseos","strong":"G1939","morph":"N-APF"},{"text":"mundanos,","strong":"G2886","morph":"A-APF"},{"text":"vivamos","strong":"G2198","morph":"V-AAS-1P"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"este"},{"text":"siglo"},{"text":"templada,"},{"text":"y"},{"text":"justa,"},{"text":"y"},{"text":"píamente,"}],"strongs":["G1722","G1939","G2198","G2886","G3588"]},"13":{"text":"Esperando aquella esperanza bienaventurada, y la manifestación gloriosa del gran Dios y Salvador nuestro Jesucristo,","segments":[{"text":"Esperando"},{"text":"aquella"},{"text":"esperanza","strong":"G1680","morph":"N-ASF"},{"text":"bienaventurada,"},{"text":"y"},{"text":"la","strong":"G3588","morph":"T-ASF"},{"text":"manifestación","strong":"G2015","morph":"N-ASF"},{"text":"gloriosa"},{"text":"del"},{"text":"gran","strong":"G3173","morph":"A-GSM"},{"text":"Dios","strong":"G2316","morph":"N-GSM-T"},{"text":"y"},{"text":"Salvador"},{"text":"nuestro","strong":"G3165","morph":"P-1GP"},{"text":"Jesucristo,"}],"strongs":["G1680","G2015","G2316","G3165","G3173","G3588"]},"14":{"text":"Que se dio a sí mismo por nosotros para redimirnos de toda iniquidad, y limpiar para sí un pueblo propio, celoso de buenas obras.","segments":[{"text":"Que"},{"text":"se"},{"text":"dio","strong":"G1325","morph":"V-AAI-3S"},{"text":"a"},{"text":"sí"},{"text":"mismo"},{"text":"por","strong":"G5228","morph":"PREP"},{"text":"nosotros","strong":"G3165","morph":"P-1GP"},{"text":"para"},{"text":"redimirnos"},{"text":"de"},{"text":"toda","strong":"G3956","morph":"A-GSF"},{"text":"iniquidad,"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"limpiar"},{"text":"para"},{"text":"sí"},{"text":"un"},{"text":"pueblo","strong":"G2992","morph":"N-ASM"},{"text":"propio,"},{"text":"celoso","strong":"G2207","morph":"N-ASM-T"},{"text":"de"},{"text":"buenas"},{"text":"obras.","strong":"G2041","morph":"N-GPN"}],"strongs":["G1325","G2041","G2207","G2532","G2992","G3165","G3956","G5228"]},"15":{"text":"Esto habla y exhorta, y reprende con toda autoridad. Nadie te desprecie.","segments":[{"text":"Esto"},{"text":"habla"},{"text":"y"},{"text":"exhorta,"},{"text":"y"},{"text":"reprende"},{"text":"con","strong":"G3326","morph":"PREP"},{"text":"toda","strong":"G3956","morph":"A-GSF"},{"text":"autoridad."},{"text":"Nadie","strong":"G3367","morph":"A-NSM"},{"text":"te"},{"text":"desprecie."}],"strongs":["G3326","G3367","G3956"]}},"3":{"1":{"text":"Amonéstales que se sujeten a los príncipes y potestades, que obedezcan, que estén prontos a toda buena obra.","segments":[{"text":"Amonéstales"},{"text":"que"},{"text":"se"},{"text":"sujeten"},{"text":"a"},{"text":"los"},{"text":"príncipes"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"potestades,"},{"text":"que"},{"text":"obedezcan,"},{"text":"que"},{"text":"estén"},{"text":"prontos"},{"text":"a"},{"text":"toda","strong":"G3956","morph":"A-ASN"},{"text":"buena","strong":"G18","morph":"A-ASN"},{"text":"obra.","strong":"G2041","morph":"N-ASN"}],"strongs":["G18","G2041","G2532","G3956"]},"2":{"text":"Que a nadie infamen, que no sean pendencieros, sino modestos, mostrando toda mansedumbre para con todos los hombres.","segments":[{"text":"Que"},{"text":"a"},{"text":"nadie","strong":"G3367","morph":"A-ASM"},{"text":"infamen,"},{"text":"que"},{"text":"no"},{"text":"sean"},{"text":"pendencieros,"},{"text":"sino"},{"text":"modestos,"},{"text":"mostrando"},{"text":"toda"},{"text":"mansedumbre"},{"text":"para"},{"text":"con"},{"text":"todos","strong":"G3956","morph":"A-APM"},{"text":"los"},{"text":"hombres.","strong":"G444","morph":"N-APM"}],"strongs":["G444","G3367","G3956"]},"3":{"text":"Porque también éramos nosotros necios en otro tiempo, rebeldes, extraviados, sirviendo a concupiscencias y deleites diversos, viviendo en malicia y en envidia, aborrecibles, aborreciendo los unos a los otros.","segments":[{"text":"Porque","strong":"G1063","morph":"CONJ"},{"text":"también","strong":"G2532","morph":"CONJ"},{"text":"éramos"},{"text":"nosotros","strong":"G3165","morph":"P-1NP"},{"text":"necios"},{"text":"en"},{"text":"otro"},{"text":"tiempo,"},{"text":"rebeldes,"},{"text":"extraviados,"},{"text":"sirviendo"},{"text":"a"},{"text":"concupiscencias"},{"text":"y"},{"text":"deleites"},{"text":"diversos,"},{"text":"viviendo"},{"text":"en"},{"text":"malicia"},{"text":"y"},{"text":"en"},{"text":"envidia,","strong":"G5355","morph":"N-DSM"},{"text":"aborrecibles,","strong":"G4767","morph":"A-NPM"},{"text":"aborreciendo"},{"text":"los"},{"text":"unos"},{"text":"a"},{"text":"los"},{"text":"otros."}],"strongs":["G1063","G2532","G3165","G4767","G5355"]},"4":{"text":"Pero cuando se manifestó la bondad de Dios nuestro Salvador, y su amor para con los hombres,","segments":[{"text":"Pero","strong":"G1161","morph":"CONJ"},{"text":"cuando","strong":"G3753","morph":"CONJ"},{"text":"se"},{"text":"manifestó"},{"text":"la","strong":"G3588","morph":"T-NSF"},{"text":"bondad","strong":"G5544","morph":"N-NSF"},{"text":"de"},{"text":"Dios","strong":"G2316","morph":"N-GSM-T"},{"text":"nuestro","strong":"G3165","morph":"P-1GP"},{"text":"Salvador,","strong":"G4990","morph":"N-GSM"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"su"},{"text":"amor"},{"text":"para"},{"text":"con"},{"text":"los"},{"text":"hombres,"}],"strongs":["G1161","G2316","G2532","G3165","G3588","G3753","G4990","G5544"]},"5":{"text":"No por obras de justicia que nosotros habíamos hecho, sino que por su misericordia nos salvó, por el lavacro de la regeneración, y de la renovación del Espíritu Santo;","segments":[{"text":"No","strong":"G3756","morph":"PRT-N"},{"text":"por"},{"text":"obras","strong":"G2041","morph":"N-GPN"},{"text":"de"},{"text":"justicia","strong":"G1343","morph":"N-DSF"},{"text":"que"},{"text":"nosotros","strong":"G3165","morph":"P-1NP"},{"text":"habíamos"},{"text":"hecho,"},{"text":"sino","strong":"G235","morph":"CONJ"},{"text":"que"},{"text":"por"},{"text":"su"},{"text":"misericordia","strong":"G1656","morph":"N-ASN"},{"text":"nos"},{"text":"salvó,","strong":"G4982","morph":"V-AAI-3S"},{"text":"por"},{"text":"el"},{"text":"lavacro"},{"text":"de"},{"text":"la"},{"text":"regeneración,"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"de"},{"text":"la"},{"text":"renovación"},{"text":"del"},{"text":"Espíritu"},{"text":"Santo;","strong":"G40","morph":"A-GSN"}],"strongs":["G40","G235","G1343","G1656","G2041","G2532","G3165","G3756","G4982"]},"6":{"text":"El cual derramó en nosotros abundantemente por Jesucristo nuestro Salvador,","segments":[{"text":"El","strong":"G3588","morph":"T-GSM"},{"text":"cual"},{"text":"derramó","strong":"G1632","morph":"V-AAI-3S"},{"text":"en"},{"text":"nosotros","strong":"G3165","morph":"P-1AP"},{"text":"abundantemente"},{"text":"por"},{"text":"Jesucristo"},{"text":"nuestro","strong":"G3165","morph":"P-1GP"},{"text":"Salvador,","strong":"G4990","morph":"N-GSM"}],"strongs":["G1632","G3165","G3588","G4990"]},"7":{"text":"Para que, justificados por su gracia, seamos hechos herederos según la esperanza de la vida eterna.","segments":[{"text":"Para"},{"text":"que,","strong":"G2443","morph":"CONJ"},{"text":"justificados"},{"text":"por"},{"text":"su"},{"text":"gracia,"},{"text":"seamos"},{"text":"hechos"},{"text":"herederos","strong":"G2818","morph":"N-NPM"},{"text":"según","strong":"G2596","morph":"PREP"},{"text":"la"},{"text":"esperanza","strong":"G1680","morph":"N-ASF"},{"text":"de"},{"text":"la"},{"text":"vida"},{"text":"eterna.","strong":"G166","morph":"A-GSF"}],"strongs":["G166","G1680","G2443","G2596","G2818"]},"8":{"text":"Palabra fiel, y estas cosas quiero que afirmes, para que los que creen a Dios procuren gobernarse en buenas obras. Estas cosas son buenas y útiles a los hombres.","segments":[{"text":"Palabra","strong":"G3056","morph":"N-NSM"},{"text":"fiel,","strong":"G4103","morph":"A-NSM"},{"text":"y"},{"text":"estas"},{"text":"cosas"},{"text":"quiero"},{"text":"que"},{"text":"afirmes,"},{"text":"para"},{"text":"que","strong":"G2443","morph":"CONJ"},{"text":"los"},{"text":"que"},{"text":"creen"},{"text":"a"},{"text":"Dios","strong":"G2316","morph":"N-DSM-T"},{"text":"procuren"},{"text":"gobernarse"},{"text":"en"},{"text":"buenas"},{"text":"obras.","strong":"G2041","morph":"N-GPN"},{"text":"Estas"},{"text":"cosas"},{"text":"son"},{"text":"buenas"},{"text":"y"},{"text":"útiles"},{"text":"a"},{"text":"los","strong":"G3588","morph":"T-DPM"},{"text":"hombres.","strong":"G444","morph":"N-DPM"}],"strongs":["G444","G2041","G2316","G2443","G3056","G3588","G4103"]},"9":{"text":"Pero las cuestiones necias, y genealogías, y contenciones, y debates acerca de la ley, evita; porque son sin provecho y vanas.","segments":[{"text":"Pero","strong":"G1161","morph":"CONJ"},{"text":"las"},{"text":"cuestiones"},{"text":"necias,","strong":"G3474","morph":"A-APF"},{"text":"y"},{"text":"genealogías,","strong":"G1076","morph":"N-APF"},{"text":"y"},{"text":"contenciones,"},{"text":"y"},{"text":"debates"},{"text":"acerca"},{"text":"de"},{"text":"la"},{"text":"ley,"},{"text":"evita;"},{"text":"porque","strong":"G1063","morph":"CONJ"},{"text":"son"},{"text":"sin"},{"text":"provecho"},{"text":"y"},{"text":"vanas."}],"strongs":["G1063","G1076","G1161","G3474"]},"10":{"text":"Rehusa hombre hereje, después de una y otra amonestación;","segments":[{"text":"Rehusa"},{"text":"hombre","strong":"G444","morph":"N-ASM"},{"text":"hereje,"},{"text":"después"},{"text":"de"},{"text":"una"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"otra"},{"text":"amonestación;"}],"strongs":["G444","G2532"]},"11":{"text":"Estando cierto que el tal es trastornado, y peca, siendo condenado de su propio juicio.","segments":[{"text":"Estando"},{"text":"cierto"},{"text":"que","strong":"G3754","morph":"CONJ"},{"text":"el","strong":"G3588","morph":"T-NSM"},{"text":"tal","strong":"G5108","morph":"D-NSM"},{"text":"es"},{"text":"trastornado,"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"peca,"},{"text":"siendo"},{"text":"condenado"},{"text":"de"},{"text":"su"},{"text":"propio"},{"text":"juicio."}],"strongs":["G2532","G3588","G3754","G5108"]},"12":{"text":"Cuando envíe a ti a Artemas, o a Tichîco, procura venir a mí, a Nicópolis: porque allí he determinado invernar.","segments":[{"text":"Cuando","strong":"G3752","morph":"CONJ"},{"text":"envíe"},{"text":"a"},{"text":"ti","strong":"G4771","morph":"P-2A