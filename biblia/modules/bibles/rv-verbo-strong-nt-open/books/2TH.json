,"G4592"]},"10":{"text":"Y con todo engaño de iniquidad en los que perecen; por cuanto no recibieron el amor de la verdad para ser salvos.","segments":[{"text":"Y","strong":"G2532","morph":"CONJ"},{"text":"con"},{"text":"todo"},{"text":"engaño"},{"text":"de"},{"text":"iniquidad"},{"text":"en"},{"text":"los"},{"text":"que"},{"text":"perecen;"},{"text":"por"},{"text":"cuanto"},{"text":"no","strong":"G3756","morph":"PRT-N"},{"text":"recibieron"},{"text":"el"},{"text":"amor","strong":"G26","morph":"N-ASF"},{"text":"de"},{"text":"la","strong":"G3588","morph":"T-GSF"},{"text":"verdad","strong":"G225","morph":"N-GSF"},{"text":"para"},{"text":"ser"},{"text":"salvos."}],"strongs":["G26","G225","G2532","G3588","G3756"]},"11":{"text":"Por tanto, pues, les envía Dios operación de error, para que crean a la mentira;","segments":[{"text":"Por","strong":"G1223","morph":"PREP"},{"text":"tanto,"},{"text":"pues,"},{"text":"les"},{"text":"envía"},{"text":"Dios","strong":"G2316","morph":"N-NSM-T"},{"text":"operación"},{"text":"de"},{"text":"error,","strong":"G4106","morph":"N-GSF"},{"text":"para"},{"text":"que"},{"text":"crean"},{"text":"a"},{"text":"la","strong":"G3588","morph":"T-DSN"},{"text":"mentira;","strong":"G5579","morph":"N-DSN"}],"strongs":["G1223","G2316","G3588","G4106","G5579"]},"12":{"text":"Para que sean condenados todos los que no creyeron a la verdad, antes consintieron a la iniquidad.","segments":[{"text":"Para"},{"text":"que","strong":"G2443","morph":"CONJ"},{"text":"sean"},{"text":"condenados"},{"text":"todos","strong":"G3956","morph":"A-NPM"},{"text":"los","strong":"G3588","morph":"T-NPM"},{"text":"que"},{"text":"no","strong":"G3361","morph":"PRT-N"},{"text":"creyeron"},{"text":"a"},{"text":"la"},{"text":"verdad,","strong":"G225","morph":"N-DSF"},{"text":"antes"},{"text":"consintieron"},{"text":"a"},{"text":"la"},{"text":"iniquidad."}],"strongs":["G225","G2443","G3361","G3588","G3956"]},"13":{"text":"Pero nosotros debemos dar siempre gracias a Dios por ustedes, he