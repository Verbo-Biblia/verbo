","strong":"G2532","morph":"CONJ"},{"text":"retengan"},{"text":"la"},{"text":"doctrina"},{"text":"que"},{"text":"han"},{"text":"aprendido,"},{"text":"sea"},{"text":"por"},{"text":"palabra,","strong":"G3056","morph":"N-GSM"},{"text":"o"},{"text":"por"},{"text":"carta","strong":"G1992","morph":"N-GSF"},{"text":"nuestra."}],"strongs":["G80","G1992","G2532","G3056"]},"16":{"text":"Y el mismo Señor nuestro Jesucristo, y Dios y Padre nuestro, el cual nos amó, y nos dio consolación eterna, y buena esperanza por gracia,","segments":[{"text":"Y"},{"text":"el"},{"text":"mismo","strong":"G846","morph":"P-NSM"},{"text":"Señor","strong":"G2962","morph":"N-NSM-T"},{"text":"nuestro"},{"text":"Jesucristo,"},{"text":"y"},{"text":"Dios","strong":"G2316","morph":"N-NSM-T"},{"text":"y"},{"text":"Padre","strong":"G3962","morph":"N-NSM-T"},{"text":"nuestro,"},{"text":"el"},{"text":"cual"},{"text":"nos"},{"text":"amó,"},{"text":"y"},{"text":"nos"},{"text":"dio"},{"text":"consolación","strong":"G3874","morph":"N-ASF"},{"text":"eterna,","strong":"G166","morph":"A-ASF"},{"text":"y"},{"text":"buena","strong":"G18","morph":"A-ASF"},{"text":"esperanza","strong":"G1680","morph":"N-ASF"},{"text":"por"},{"text":"gracia,"}],"strongs":["G18","G166","G846","G1680","G2316","G2962","G3874","G3962"]},"17":{"text":"Consuele sus corazones, y les confirme en toda buena palabra y obra.","segments":[{"text":"Consuele","strong":"G3870","morph":"V-AAO-3S"},{"text":"sus"},{"text":"corazones,","strong":"G2588","morph":"N-APF"},{"text":"y"},{"text":"les"},{"text":"confirme"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"toda","strong":"G3956","morph":"A-DSN"},{"text":"buena","strong":"G18","morph":"A-DSM"},{"text":"palabra","strong":"G3056","morph":"N-DSM"},{"text":"y"},{"text":"obra.","strong":"G2041","morph":"N-DSN"}],"strongs":["G18","G1722","G2041","G2588","G3056","G3870","G3956"]}},"3":{"1":{"text":"Resta, hermanos, que oren por nosotros, que la palabra del Señor corra y sea glorificada así como entre ustedes:","segments":[{"text":"Resta,"},{"text":"hermanos,","strong":"G80","morph":"N-VPM"},{"text":"que"},{"text":"oren"},{"text":"por"},{"text":"nosotros,","strong":"G3165","morph":"P-1GP"},{"text":"que"},{"text":"la","strong":"G3588","morph":"T-NSM"},{"text":"palabra","strong":"G3056","morph":"N-NSM"},{"text":"del"},{"text":"Señor","strong":"G2962","morph":"N-GSM-T"},{"text":"corra"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"sea"},{"text":"glorificada"},{"text":"así"},{"text":"como"},{"text":"entre"},{"text":"ustedes:"}],"strongs":["G80","G2532","G2962","G3056","G3165","G3588"]},"2":{"text":"Y que seamos librados de hombres importunos y malos; porque no es de todos la fe.","segments":[{"text":"Y"},{"text":"que"},{"text":"seamos","strong":"G4506","morph":"V-APS-1P"},{"text":"librados"},{"text":"de"},{"text":"hombres","strong":"G444","morph":"N-GPM"},{"text":"importunos"},{"text":"y"},{"text":"malos;"},{"text":"porque","strong":"G1063","morph":"CONJ"},{"text":"no","strong":"G3756","morph":"PRT-N"},{"text":"es"},{"text":"de"},{"text":"todos","strong":"G3956","morph":"A-GPM"},{"text":"la","strong":"G3588","morph":"T-NSF"},{"text":"fe."}],"strongs":["G444","G1063","G3588","G3756","G3956","G4506"]},"3":{"text":"Pero fiel es el Señor, que les confirmará y guardará del mal.","segments":[{"text":"Pero","strong":"G1161","morph":"CONJ"},{"text":"fiel","strong":"G4103","morph":"A-NSM"},{"text":"es"},{"text":"el"},{"text":"Señor,","strong":"G2962","morph":"N-NSM-T"},{"text":"que"},{"text":"les"},{"text":"confirmará"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"guardará","strong":"G5442","morph":"V-FAI-3S"},{"text":"del"},{"text":"mal."}],"strongs":["G1161","G2532","G2962","G4103","G5442"]},"4":{"text":"Y tenemos confianza de ustedes en el Señor, que hacen y harán lo que les hemos mandado.","segments":[{"text":"Y"},{"text":"tenemos"},{"text":"confianza"},{"text":"de"},{"text":"ustedes","strong":"G4771","morph":"P-2AP"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"el"},{"text":"Señor,","strong":"G2962","morph":"N-DSM-T"},{"text":"que"},{"text":"hacen"},{"text":"y"},{"text":"harán","strong":"G4160","morph":"V-FAI-2P"},{"text":"lo"},{"text":"que"},{"text":"les"},{"text":"hemos"},{"text":"mandado."}],"strongs":["G1722","G2962","G4160","G4771"]},"5":{"text":"Y el Señor enderece sus corazones en el amor de Dios, y en la paciencia de Cristo.","segments":[{"text":"Y"},{"text":"el"},{"text":"Señor","strong":"G2962","morph":"N-NSM-T"},{"text":"enderece"},{"text":"sus"},{"text":"corazones","strong":"G2588","morph":"N-APF"},{"text":"en"},{"text":"el"},{"text":"amor","strong":"G26","morph":"N-ASF"},{"text":"de"},{"text":"Dios,","strong":"G2316","morph":"N-GSM-T"},{"text":"y"},{"text":"en"},{"text":"la"},{"text":"paciencia"},{"text":"de"},{"text":"Cristo."}],"strongs":["G26","G2316","G2588","G2962"]},"6":{"text":"Pero les denunciamos, hermanos, en el nombre de nuestro Señor Jesucristo, que se aparten de todo hermano que ande fuera de orden, y no conforme a la doctrina que recibieron de nosotros:","segments":[{"text":"Pero","strong":"G1161","morph":"CONJ"},{"text":"les"},{"text":"denunciamos,"},{"text":"hermanos,","strong":"G80","morph":"N-VPM"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"el"},{"text":"nombre","strong":"G3686","morph":"N-DSN"},{"text":"de"},{"text":"nuestro"},{"text":"Señor","strong":"G2962","morph":"N-GSM-T"},{"text":"Jesucristo,"},{"text":"que"},{"text":"se"},{"text":"aparten"},{"text":"de"},{"text":"todo","strong":"G3956","morph":"A-GSM"},{"text":"hermano","strong":"G80","morph":"N-GSM"},{"text":"que"},{"text":"ande"},{"text":"fuera"},{"text":"de"},{"text":"orden,"},{"text":"y","strong":"G2532","morph":"CONJ"},{"text":"no","strong":"G3361","morph":"PRT-N"},{"text":"conforme"},{"text":"a"},{"text":"la","strong":"G3588","morph":"T-ASF"},{"text":"doctrina"},{"text":"que"},{"text":"recibieron"},{"text":"de"},{"text":"nosotros:","strong":"G3165","morph":"P-1GP"}],"strongs":["G80","G1161","G1722","G2532","G2962","G3165","G3361","G3588","G3686","G3956"]},"7":{"text":"Porque ustedes mismos saben de qué manera deben imitarnos: porque no anduvimos desordenadamente entre ustedes,","segments":[{"text":"Porque"},{"text":"ustedes","strong":"G846","morph":"P-NPM"},{"text":"mismos"},{"text":"saben"},{"text":"de"},{"text":"qué","strong":"G3754","morph":"CONJ"},{"text":"manera"},{"text":"deben"},{"text":"imitarnos:"},{"text":"porque"},{"text":"no","strong":"G3756","morph":"PRT-N"},{"text":"anduvimos"},{"text":"desordenadamente"},{"text":"entre","strong":"G1722","morph":"PREP"},{"text":"ustedes,"}],"strongs":["G846","G1722","G3754","G3756"]},"8":{"text":"Ni comimos el pan de ninguno de balde; antes, obrando con trabajo y fatiga de noche y de día, por no ser gravosos a ninguno de ustedes;","segments":[{"text":"Ni","strong":"G3761","morph":"CONJ-N"},{"text":"comimos","strong":"G5315","morph":"V-AAI-1P"},{"text":"el","strong":"G3588","morph":"T-ASN"},{"text":"pan","strong":"G740","morph":"N-ASM"},{"text":"de"},{"text":"ninguno"},{"text":"de"},{"text":"balde;"},{"text":"antes,"},{"text":"obrando"},{"text":"con"},{"text":"trabajo"},{"text":"y"},{"text":"fatiga"},{"text":"de"},{"text":"noche","strong":"G3571","morph":"N-GSF"},{"text":"y"},{"text":"de"},{"text":"día,","strong":"G2250","morph":"N-GSF"},{"text":"por"},{"text":"no","strong":"G3361","morph":"PRT-N"},{"text":"ser"},{"text":"gravosos"},{"text":"a"},{"text":"ninguno"},{"text":"de"},{"text":"ustedes;","strong":"G4771","morph":"P-2GP"}],"strongs":["G740","G2250","G3361","G3571","G3588","G3761","G4771","G5315"]},"9":{"text":"No porque no tuviésemos potestad, sino por darles en nosotros un dechado, para que nos imitasen.","segments":[{"text":"No"},{"text":"porque"},{"text":"no"},{"text":"tuviésemos"},{"text":"potestad,"},{"text":"sino","strong":"G235","morph":"CONJ"},{"text":"por"},{"text":"darles"},{"text":"en"},{"text":"nosotros"},{"text":"un"},{"text":"dechado,"},{"text":"para"},{"text":"que","strong":"G2443","morph":"CONJ"},{"text":"nos"},{"text":"imitasen."}],"strongs":["G235","G2443"]},"10":{"text":"Porque aun estando con ustedes, les denunciábamos esto: Que si alguno no quiere trabajar, tampoco coma.","segments":[{"text":"Porque","strong":"G1063","morph":"CONJ"},{"text":"aun"},{"text":"estando"},{"text":"con"},{"text":"ustedes,"},{"text":"les"},{"text":"denunciábamos"},{"text":"esto:","strong":"G3778","morph":"D-ASN"},{"text":"Que","strong":"G3754","morph":"CONJ"},{"text":"si","strong":"G1487","morph":"COND"},{"text":"alguno"},{"text":"no","strong":"G3756","morph":"PRT-N"},{"text":"quiere"},{"text":"trabajar,"},{"text":"tampoco","strong":"G3366","morph":"ADV-N"},{"text":"coma."}],"strongs":["G1063","G1487","G3366","G3754","G3756","G3778"]},"11":{"text":"Porque oímos que andan algunos entre ustedes fuera de orden, no trabajando en nada, sino ocupados en curiosear.","segments":[{"text":"Porque","strong":"G1063","morph":"CONJ"},{"text":"oímos"},{"text":"que"},{"text":"andan"},{"text":"algunos"},{"text":"entre"},{"text":"ustedes","strong":"G4771","morph":"P-2DP"},{"text":"fuera"},{"text":"de"},{"text":"orden,"},{"text":"no"},{"text":"trabajando"},{"text":"en"},{"text":"nada,","strong":"G3367","morph":"A-ASN-N"},{"text":"sino","strong":"G235","morph":"CONJ"},{"text":"ocupados"},{"text":"en"},{"text":"curiosear."}],"strongs":["G235","G1063","G3367","G4771"]},"12":{"text":"Y a los tales requerimos y rogamos por nuestro Señor Jesucristo, que, trabajando con reposo, coman su pan.","segments":[{"text":"Y"},{"text":"a"},{"text":"los","strong":"G3588","morph":"T-DPM"},{"text":"tales","strong":"G5108","morph":"D-DPM"},{"text":"requerimos"},{"text":"y"},{"text":"rogamos"},{"text":"por"},{"text":"nuestro"},{"text":"Señor","strong":"G2962","morph":"N-DSM-T"},{"text":"Jesucristo,"},{"text":"que,"},{"text":"trabajando"},{"text":"con","strong":"G3326","morph":"PREP"},{"text":"reposo,"},{"text":"coman"},{"text":"su"},{"text":"pan.","strong":"G740","morph":"N-ASM"}],"strongs":["G740","G2962","G3326","G3588","G5108"]},"13":{"text":"Y ustedes, hermanos, no se cansen de hacer bien.","segments":[{"text":"Y"},{"text":"ustedes,","strong":"G4771","morph":"P-2NP"},{"text":"hermanos,","strong":"G80","morph":"N-VPM"},{"text":"no","strong":"G3361","morph":"PRT-N"},{"text":"se"},{"text":"cansen"},{"text":"de"},{"text":"hacer"},{"text":"bien."}],"strongs":["G80","G3361","G4771"]},"14":{"text":"Y si alguno no obedece a nuestra palabra por carta, noten al tal, y no se junten con él, para que se avergüence.","segments":[{"text":"Y"},{"text":"si","strong":"G1487","morph":"COND"},{"text":"alguno"},{"text":"no"},{"text":"obedece"},{"text":"a"},{"text":"nuestra","strong":"G3165","morph":"P-1GP"},{"text":"palabra","strong":"G3056","morph":"N-DSM"},{"text":"por"},{"text":"carta,","strong":"G1992","morph":"N-GSF"},{"text":"noten"},{"text":"al"},{"text":"tal,"},{"text":"y"},{"text":"no"},{"text":"se"},{"text":"junten"},{"text":"con"},{"text":"él,","strong":"G846","morph":"P-DSM"},{"text":"para"},{"text":"que","strong":"G2443","morph":"CONJ"},{"text":"se"},{"text":"avergüence."}],"strongs":["G846","G1487","G1992","G2443","G3056","G3165"]},"15":{"text":"Pero no lo tengan como a enemigo, sino amonéstenle como a hermano.","segments":[{"text":"Pero"},{"text":"no","strong":"G3361","morph":"PRT-N"},{"text":"lo"},{"text":"tengan"},{"text":"como"},{"text":"a"},{"text":"enemigo,","strong":"G2190","morph":"N-ASM"},{"text":"sino","strong":"G235","morph":"CONJ"},{"text":"amonéstenle"},{"text":"como"},{"text":"a"},{"text":"hermano.","strong":"G80","morph":"N-ASM"}],"strongs":["G80","G235","G2190","G3361"]},"16":{"text":"Y el mismo Señor de paz les dé siempre paz en toda manera. El Señor sea con todos ustedes.","segments":[{"text":"Y"},{"text":"el"},{"text":"mismo","strong":"G846","morph":"P-NSM"},{"text":"Señor"},{"text":"de"},{"text":"paz"},{"text":"les"},{"text":"dé"},{"text":"siempre"},{"text":"paz"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"toda","strong":"G3956","morph":"A-DSM"},{"text":"manera.","strong":"G5158","morph":"N-DSM"},{"text":"El"},{"text":"Señor"},{"text":"sea"},{"text":"con","strong":"G3326","morph":"PREP"},{"text":"todos","strong":"G3956","morph":"A-GPM"},{"text":"ustedes.","strong":"G4771","morph":"P-2GP"}],"strongs":["G846","G1722","G3326","G3956","G4771","G5158"]},"17":{"text":"Salud de mi mano, Pablo, que es mi signo en toda carta mía: así escribo.","segments":[{"text":"Salud"},{"text":"de"},{"text":"mi"},{"text":"mano,","strong":"G5495","morph":"N-DSF"},{"text":"Pablo,","strong":"G3972","morph":"N-GSM-P"},{"text":"que"},{"text":"es"},{"text":"mi"},{"text":"signo"},{"text":"en","strong":"G1722","morph":"PREP"},{"text":"toda","strong":"G3956","morph":"A-DSF"},{"text":"carta","strong":"G1992","morph":"N-DSF"},{"text":"mía:"},{"text":"así","strong":"G3779","morph":"ADV"},{"text":"escribo."}],"strongs":["G1722","G1992","G3779","G3956","G3972","G5495"]},"18":{"text":"La gracia de nuestro Señor Jesucristo sea con todos ustedes. Amén. La segunda Epístola a los Tesalonicenses fue escrita de Atenas.","segments":[{"text":"La"},{"text":"gracia"},{"text":"de"},{"text":"nuestro","strong":"G3165","morph":"P-1GP"},{"text":"Señor","strong":"G2962","morph":"N-GSM-T"},{"text":"Jesucristo"},{"text":"sea"},{"text":"con","strong":"G3326","morph":"PREP"},{"text":"todos","strong":"G3956","morph":"A-GPM"},{"text":"ustedes.","strong":"G4771","morph":"P-2GP"},{"text":"Amén.","strong":"G281","morph":"INJ-HEB"},{"text":"La"},{"text":"segunda"},{"text":"Epístola"},{"text":"a"},{"text":"los"},{"text":"Tesalonicenses"},{"text":"fue"},{"text":"escrita"},{"text":"de"},{"text":"Atenas.","strong":"G116","morph":"N-GPF-L"}],"strongs":["G116","G281","G2962","G3165","G3326","G3956","G4771"]}}}}