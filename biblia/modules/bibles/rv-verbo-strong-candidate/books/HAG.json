"},{"text":"su"},{"text":"corazón"},{"text":"desde"},{"text":"este"},{"text":"día"},{"text":"en"},{"text":"adelante,"},{"text":"antes"},{"text":"que"},{"text":"pusiesen"},{"text":"piedra"},{"text":"sobre"},{"text":"piedra"},{"text":"en"},{"text":"el"},{"text":"templo"},{"text":"de"},{"text":"Jehová,","strong":"H3068","morph":"HNpt"}],"strongs":["H3068"]},"16":{"text":"Antes que fuesen estas cosas, venían al montón de veinte hanegas, y había diez; venían al lagar para sacar cincuenta cántaros del lagar, y había veinte.","segments":[{"text":"Antes"},{"text":"que"},{"text":"fuesen"},{"text":"estas"},{"text":"cosas,"},{"text":"venían"},{"text":"al"},{"text":"montón"},{"text":"de"},{"text":"veinte"},{"text":"hanegas,"},{"text":"y"},{"text":"había"},{"text":"diez;"},{"text":"venían"},{"text":"al"},{"text":"lagar"},{"text":"para"},{"text":"sacar"},{"text":"cincuenta","strong":"H2572","morph":"HAcmpa"},{"text":"cántaros"},{"text":"del"},{"text":"lagar,"},{"text":"y"},{"text":"había"},{"text":"veinte."}],"strongs":["H2572"]},"17":{"text":"Les herí con viento solano, y con tizoncillo, y con granizo en toda obra de sus manos; pero no se convirtieron a mí, dice Jehová.","segments":[{"text":"Les"},{"text":"herí"},{"text":"con"},{"text":"viento"},{"text":"solano,"},{"text":"y"},{"text":"con"},{"text":"tizoncillo,"},{"text":"y"},{"text":"con"},{"text":"granizo","strong":"H1259","morph":"HC/Rd/Ncmsa"},{"text":"en"},{"text":"toda"},{"text":"obra"},{"text":"de"},{"text":"sus"},{"text":"manos;"},{"text":"pero"},{"text":"no"},{"text":"se"},{"text":"convirtieron"},{"text":"a"},{"text":"mí,"},{"text":"dice"},{"text":"Jehová.","strong":"H3068","morph":"HNpt"}],"strongs":["H1259","H3068"]},"18":{"text":"Pues pongan ahora su corazón desde este día en adelante, desde el día veinticuatro del noveno mes, desde el día que se echó el cimiento al templo de Jehová; pongan su corazón.","segments":[{"text":"Pues"},{"text":"pongan"},{"text":"ahora"},{"text":"su"},{"text":"corazón"},{"text":"desde"},{