":"N-GSM-T"},{"text":"Jesucristo"},{"text":"sea"},{"text":"con","strong":"G3326","morph":"PREP"},{"text":"su"},{"text":"espíritu.","strong":"G4151","morph":"N-GSN"},{"text":"Amén.","strong":"G281","morph":"INJ-HEB"},{"text":"A"},{"text":"Filemón","strong":"G5371","morph":"N-ASM-P"},{"text":"fue"},{"text":"enviada"},{"text":"de"},{"text":"Roma","strong":"G4516","morph":"N-GSF-L"},{"text":"por"},{"text":"Onésimo,","strong":"G3682","morph":"N-GSM-P"},{"text":"siervo."}],"strongs":["G281","G2962","G3326","G3588","G3682","G4151","G4516","G5371"]}}}}