{"entries":[{"id":"wesley-psa-86-2","title":"Psalms 86:2","author":"John Wesley (1703–1791)","reference":{"book":"PSA","chapterStart":86,"verseStart":2,"chapterEnd":86,"verseEnd":2},"content":"<p>Holy - Sincerely devoted to thy service.</p>"},{"id":"wesley-psa-86-11","title":"Psalms 86:11","author":"John Wesley (1703–1791)","reference":{"book":"PSA","chapterStart":86,"verseStart":11,"chapterEnd":86,"verseEnd":11},"content":"<p>Truth - In the way of thy precepts, which are true and right in all things. My heart - Knit my whole heart to thyself.</p>"},{"id":"wesley-psa-86-13","title":"Psalms 86:13","author":"John Wesley (1703–1791)","reference":{"book":"PSA","chapterStart":86,"verseStart":13,"chapterEnd":86,"verseEnd":13},"content":"<p>Hell - From extreme dangers and miseries.</p>"}]}