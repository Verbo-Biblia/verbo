{"entries":[{"id":"tsk-psa-23-1","title":"Psalms 23:1","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":23,"verseStart":1,"chapterEnd":23,"verseEnd":1},"content":"<p>1 David's confidence in God's grace.</p>\n<p>my. 79:13; 80:1; Isa 40:11; Jer 23:3,4; Eze 34:11,12,23,24; Mic 5:2,4 Joh 10:11,14,27-30; Heb 13:20; 1Pe 2:25; 5:4; Re 7:17 I shall. 34:9,10; 84:11; Mt 6:33; Lu 12:30-32; Ro 8:32; Php 4:19; Heb 13:5,6</p>"},{"id":"tsk-psa-23-2","title":"Psalms 23:2","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":23,"verseStart":2,"chapterEnd":23,"verseEnd":2},"content":"<p>maketh. Isa 30:23; Eze 34:13,14 green pastures. Heb. pastures of tender grass. leadeth. 46:4; Isa 49:9,10; Re 7:17; 21:6; 22:1,17 still waters. Heb. waters of quietness. Job 34:29; Isa 8:6</p>"},{"id":"tsk-psa-23-3","title":"Psalms 23:3","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":23,"verseStart":3,"chapterEnd":23,"verseEnd":3},"content":"<p>restoreth. 19:7; *marg: 51:10,12; 85:4-7; 119:176; Job 33:30; Jer 32:37-42; Ho 14:4-9 Mic 7:8,9,18,19; Lu 22:31,32; Re 3:19 leadeth. 5:8; 34:3; 143:8-10; Pr 8:20; Isa 42:16; Jer 31:8 for his. 79:9; Eze 20:14; Eph 1:6</p>"},{"id":"tsk-psa-23-4","title":"Psalms 23:4","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":23,"verseStart":4,"chapterEnd":23,"verseEnd":4},"content":"<p>through. 44:19; Job 3:5; 10:21,22; 24:17; Jer 2:6; Lu 1:79 I will. 3:6; 27:1-4; 46:1-3; 118:6; 138:7; Isa 41:10; 1Co 15:55-57 for thou. 14:5; 46:11; Isa 8:9,10; 43:1,2; Zec 8:23; Mt 1:23; 28:20 Ac 18:9,10; 2Ti 4:22 thy rod. 110:2; Mic 7:14; Zec 11:10,14</p>"},{"id":"tsk-psa-23-5","title":"Psalms 23:5","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":23,"verseStart":5,"chapterEnd":23,"verseEnd":5},"content":"<p>preparest. 22:26,29; 31:19,20; 104:15; Job 36:16; Isa 25:6; Joh 6:53-56 Joh 10:9,10; 16:22 thou anointest. Heb. makest fat. 45:7; 92:10; Am 6:6; Mt 6:17; 2Co 1:21; 1Jo 2:20,27 my cup. 16:5; 116:13; 1Co 10:16; Eph 3:20</p>"},{"id":"tsk-psa-23-6","title":"Psalms 23:6","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":23,"verseStart":6,"chapterEnd":23,"verseEnd":6},"content":"<p>goodness. 30:11,12; 36:7-10; 103:17; 2Co 1:10; 2Ti 4:18 and I. 16:11; 17:15; 73:24-26; 2Co 5:1; Php 1:23 for ever. Heb. to length of days. 21:4</p>"}]}