{"entries":[{"id":"tsk-psa-114-1","title":"Psalms 114:1","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":114,"verseStart":1,"chapterEnd":114,"verseEnd":1},"content":"<p>1 The miracles wrought by God, when he brought his people out of Egypt, are a just ground of fearing him.</p>\n<p>(Title.)This short, and apparently imperfect Psalm, for elegance and sublimity, yields to few in the whole book. The composition of it is inexpressibly beautiful, and in the highest style of poetry.</p>\n<p>Israel. Ex 12:41,42; 13:3; 20:2; De 16:1; 26:8; Isa 11:16 a people. 81:5; Ge 42:23</p>"},{"id":"tsk-psa-114-2","title":"Psalms 114:2","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":114,"verseStart":2,"chapterEnd":114,"verseEnd":2},"content":"<p>Ex 6:7; 19:5,6; 25:8; 29:45,46; Le 11:45; De 23:14; 27:9,12 Eze 37:26-28; 2Co 6:16,17; Re 21:3</p>"},{"id":"tsk-psa-114-3","title":"Psalms 114:3","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":114,"verseStart":3,"chapterEnd":114,"verseEnd":3},"content":"<p>sea. 77:16; 104:7; 106:9; Ex 14:21; 15:8; Isa 63:12; Hab 3:8,15 Jordan. 74:15; Jos 3:13-16; Hab 3:9</p>"},{"id":"tsk-psa-114-4","title":"Psalms 114:4","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":114,"verseStart":4,"chapterEnd":114,"verseEnd":4},"content":"<p>39:6; 68:16; Ex 19:18; 20:18; Jud 5:4,5; Jer 4:23,24; Mic 1:3,4 Na 1:5; Hab 3:6,8; 2Pe 3:7-11; Re 20:11</p>"},{"id":"tsk-psa-114-5","title":"Psalms 114:5","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":114,"verseStart":5,"chapterEnd":114,"verseEnd":5},"content":"<p>Jer 47:6,7; Hab 3:8</p>"},{"id":"tsk-psa-114-6","title":"Psalms 114:6","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":114,"verseStart":6,"chapterEnd":114,"verseEnd":6},"content":"<p>skipped. 4; 29:6</p>"},{"id":"tsk-psa-114-7","title":"Psalms 114:7","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":114,"verseStart":7,"chapterEnd":114,"verseEnd":7},"content":"<p>Tremble. 77:18; 97:4,5; 104:32; Job 9:6; 26:11; Isa 64:1-3; Jer 5:22 Mic 6:1,2</p>"},{"id":"tsk-psa-114-8","title":"Psalms 114:8","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":114,"verseStart":8,"chapterEnd":114,"verseEnd":8},"content":"<p>78:15,16; 105:41; 107:35; Ex 17:6; Nu 20:11; De 8:15; Ne 9:15 1Co 10:4</p>"}]}