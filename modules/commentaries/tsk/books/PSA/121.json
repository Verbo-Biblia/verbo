{"entries":[{"id":"tsk-psa-121-1","title":"Psalms 121:1","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":121,"verseStart":1,"chapterEnd":121,"verseEnd":1},"content":"<p>1 The great safety of the godly, who put their trust in God's protection.</p>\n<p>(Title.) A Song. 120:1; *title I will, etc. or, Shall I lift up my eyes to the hills?whence should my help come? Jer 3:23 lift up. 2:6; 68:15,16; 78:68; 87:1; 123:1; Isa 2:3</p>"},{"id":"tsk-psa-121-2","title":"Psalms 121:2","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":121,"verseStart":2,"chapterEnd":121,"verseEnd":2},"content":"<p>My help. 46:1; 124:8; 146:5,6; Isa 40:28,29; 41:13; Jer 20:11; Ho 13:9 Heb 13:6</p>"},{"id":"tsk-psa-121-3","title":"Psalms 121:3","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":121,"verseStart":3,"chapterEnd":121,"verseEnd":3},"content":"<p>will not. 91:12; 1Sa 2:9; Pr 2:8; 3:23,26; 1Pe 1:5</p>"},{"id":"tsk-psa-121-4","title":"Psalms 121:4","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":121,"verseStart":4,"chapterEnd":121,"verseEnd":4},"content":"<p>he that. 27:1; 32:7,8; 127:1; Isa 27:3 shall. 1Ki 18:27; Ec 8:16; Re 7:15</p>"},{"id":"tsk-psa-121-5","title":"Psalms 121:5","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":121,"verseStart":5,"chapterEnd":121,"verseEnd":5},"content":"<p>thy shade. Ex 13:21; Isa 4:5,6; 25:4; 32:2; Mt 23:37 upon. 16:8; 109:31</p>"},{"id":"tsk-psa-121-6","title":"Psalms 121:6","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":121,"verseStart":6,"chapterEnd":121,"verseEnd":6},"content":"<p>the sun. 91:5-10; Isa 49:10; Re 7:16</p>"},{"id":"tsk-psa-121-7","title":"Psalms 121:7","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":121,"verseStart":7,"chapterEnd":121,"verseEnd":7},"content":"<p>preserve. 91:9,10; Job 5:19-27; Pr 12:21; Mt 6:13; Ro 8:28,35-39; 2Ti 4:18 he shall. 34:22; 41:2; 97:10; 145:20</p>"},{"id":"tsk-psa-121-8","title":"Psalms 121:8","author":"R. A. Torrey (editor)","reference":{"book":"PSA","chapterStart":121,"verseStart":8,"chapterEnd":121,"verseEnd":8},"content":"<p>thy going out. De 28:6,19; 2Sa 5:2; Ezr 8:21,31; Pr 2:8; 3:6; Jas 4:13-16 from this time. 113:2; 115:18</p>"}]}