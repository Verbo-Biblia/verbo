terStart":5,"verseStart":26,"chapterEnd":5,"verseEnd":26},"content":"<p>Ro 16:16; 1Co 16:20</p>"},{"id":"tsk-1th-5-27","title":"1 Thessalonians 5:27","author":"R. A. Torrey (editor)","reference":{"book":"1TH","chapterStart":5,"verseStart":27,"chapterEnd":5,"verseEnd":27},"content":"<p>I charge. or, I adjure. 2:11; Nu 27:23; 1Ki 22:16; 2Ch 18:15; Mt 26:63; Mr 5:7; Ac 19:13 1Ti 1:3,18; 5:7,21; 6:13,17; 2Ti 4:1 that. Col 4:16; 2Th 3:14 holy. Heb 3:1</p>"},{"id":"tsk-1th-5-28","title":"1 Thessalonians 5:28","author":"R. A. Torrey (editor)","reference":{"book":"1TH","chapterStart":5,"verseStart":28,"chapterEnd":5,"verseEnd":28},"content":"<p>Ro 1:7; 16:20,24; 2Th 3:18</p>"}]}