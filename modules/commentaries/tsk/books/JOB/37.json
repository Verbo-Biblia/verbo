{"entries":[{"id":"tsk-job-37-1","title":"Job 37:1","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":1,"chapterEnd":37,"verseEnd":1},"content":"<p>1 God is to be feared because of his great works. 15 His wisdom is unsearchable in them.</p>\n<p>4:14; 21:6; 38:1; Ex 19:16; Ps 89:7; 119:120; Jer 5:22; Da 10:7,8 Hab 3:16; Mt 28:2-4; Ac 16:26,29</p>"},{"id":"tsk-job-37-2","title":"Job 37:2","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":2,"chapterEnd":37,"verseEnd":2},"content":"<p>Hear attentively. Heb. Hear in hearing. the noise. 5; 36:29,33; 38:1; Ex 19:16-19; Ps 104:7</p>"},{"id":"tsk-job-37-3","title":"Job 37:3","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":3,"chapterEnd":37,"verseEnd":3},"content":"<p>He. Ps 77:13; 97:4; Mt 24:27; Re 11:19 lightning. Heb. light. ends. Heb. wings. 38:13; Isa 11:12; *marg:</p>"},{"id":"tsk-job-37-4","title":"Job 37:4","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":4,"chapterEnd":37,"verseEnd":4},"content":"<p>a voice. Ps 29:3-9; 68:33 the voice. Ex 15:7,8; De 33:26 he will. 36:27-33</p>"},{"id":"tsk-job-37-5","title":"Job 37:5","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":5,"chapterEnd":37,"verseEnd":5},"content":"<p>thundereth. 2Sa 22:14,15 great. 5:9; 9:10; 11:7; 26:14; 36:26; Ec 3:11; Isa 40:21,22,28; Ro 11:33 Re 15:3</p>"},{"id":"tsk-job-37-6","title":"Job 37:6","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":6,"chapterEnd":37,"verseEnd":6},"content":"<p>he. 38:22; Ps 147:16-18; 148:8 likewise to the small, etc. Heb. and to the shower of rain,and to the showers of rain of his strength. 36:27 great. Ge 7:10-12; Ezr 10:9,13; Pr 28:3; Eze 13:11,13; Am 9:6; Mt 7:25-27</p>"},{"id":"tsk-job-37-7","title":"Job 37:7","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":7,"chapterEnd":37,"verseEnd":7},"content":"<p>He. 5:12; 9:7 that. 36:24; Ps 46:8; 64:9; 92:4; 109:27; 111:2; Ec 8:17; Isa 5:12; 26:11</p>"},{"id":"tsk-job-37-8","title":"Job 37:8","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":8,"chapterEnd":37,"verseEnd":8},"content":"<p>Ps 104:22</p>"},{"id":"tsk-job-37-9","title":"Job 37:9","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":9,"chapterEnd":37,"verseEnd":9},"content":"<p>south. Heb. chamber. 9:9; Ps 104:3 the whirlwind. 38:1; Isa 21:1; Zec 9:14 north. Heb. scattering winds.</p>"},{"id":"tsk-job-37-10","title":"Job 37:10","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":10,"chapterEnd":37,"verseEnd":10},"content":"<p>38:29,30; Ps 78:47; 147:16-18</p>"},{"id":"tsk-job-37-11","title":"Job 37:11","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":11,"chapterEnd":37,"verseEnd":11},"content":"<p>he wearieth. 36:27,28 he scattereth. 36:30,32; Isa 18:4; Mt 17:5 his bright cloud. Heb. the cloud of his light.</p>"},{"id":"tsk-job-37-12","title":"Job 37:12","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":12,"chapterEnd":37,"verseEnd":12},"content":"<p>it. Ps 65:9,10; 104:24; Jer 14:22; Joe 2:23; Am 4:7 that. Ps 148:8; Jas 5:17,18; Re 11:6</p>"},{"id":"tsk-job-37-13","title":"Job 37:13","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":13,"chapterEnd":37,"verseEnd":13},"content":"<p>whether. 6; 36:31; 38:37,38; Ex 9:18-25; 1Sa 12:18,19; Ezr 10:9 correction. Heb. a rod. for his. 38:26,27 for mercy. 2Sa 21:10,14; 1Ki 18:45; Joe 2:23</p>"},{"id":"tsk-job-37-14","title":"Job 37:14","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":14,"chapterEnd":37,"verseEnd":14},"content":"<p>stand. Ex 14:13; Ps 46:10; Hab 2:20 consider. 26:6-14; 36:24; Ps 111:2; 145:5,6,10-12</p>"},{"id":"tsk-job-37-15","title":"Job 37:15","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":15,"chapterEnd":37,"verseEnd":15},"content":"<p>Dost. 28:24-27; 34:13; 38:4-41; Ps 119:90,91; Isa 40:26 the light. 11; 36:30-32; 38:24,25</p>"},{"id":"tsk-job-37-16","title":"Job 37:16","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":16,"chapterEnd":37,"verseEnd":16},"content":"<p>the balancings. 26:8; 36:29; Ps 104:2,3; Isa 40:22; Jer 10:13 perfect. 36:4; Ps 104:24; 147:5; Pr 3:19,20; Jer 10:12</p>"},{"id":"tsk-job-37-17","title":"Job 37:17","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":17,"chapterEnd":37,"verseEnd":17},"content":"<p>he. 6:17; 38:31; Ps 147:18; Lu 12:55</p>"},{"id":"tsk-job-37-18","title":"Job 37:18","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":18,"chapterEnd":37,"verseEnd":18},"content":"<p>spread. 9:8,9; Ge 1:6-8; Ps 104:2; 148:4-6; 150:1; Pr 8:27; Isa 40:12,22 Isa 44:24 as. Ex 38:8</p>"},{"id":"tsk-job-37-19","title":"Job 37:19","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":19,"chapterEnd":37,"verseEnd":19},"content":"<p>Teach. 12:3; 13:3,6 we. 26:14; 28:20,21; 38:2; 42:3; Ps 73:16,17,22; 139:6; Pr 30:2-4 1Co 13:12; 1Jo 3:2</p>"},{"id":"tsk-job-37-20","title":"Job 37:20","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":20,"chapterEnd":37,"verseEnd":20},"content":"<p>Shall it. Ps 139:4; Mt 12:36,37 surely. 6:3; 11:7,8</p>"},{"id":"tsk-job-37-21","title":"Job 37:21","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":21,"chapterEnd":37,"verseEnd":21},"content":"<p>26:9; 36:32; 38:25</p>"},{"id":"tsk-job-37-22","title":"Job 37:22","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":22,"chapterEnd":37,"verseEnd":22},"content":"<p>Fair. Heb. Gold weather. Pr 25:23 with. 40:10; 1Ch 29:11; Ps 29:4; 66:5; 68:7,8; 76:12; 93:1; 104:1; 145:5 Isa 2:10,19; Mic 5:4; Na 1:3; Hab 3:3-19; Heb 1:3; 12:29; Jude 1:25</p>"},{"id":"tsk-job-37-23","title":"Job 37:23","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":23,"chapterEnd":37,"verseEnd":23},"content":"<p>we. 19; 11:7; 26:14; 36:26; Pr 30:3,4; Ec 3:11; Lu 10:22; Ro 11:33 1Ti 6:16 excellent. 9:4,19; 12:13; 36:5; Ps 62:11; 65:6; 66:3; 93:1; 99:4; 146:6,7 Isa 45:21; Mt 6:13 in judgment. Ps 36:5-7 he will. 16:7-17; Ps 30:5; La 3:32,33; Heb 12:10</p>"},{"id":"tsk-job-37-24","title":"Job 37:24","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":37,"verseStart":24,"chapterEnd":37,"verseEnd":24},"content":"<p>fear. Ps 130:4; Jer 32:39; 33:9; Ho 3:5; Mt 10:28; Lu 12:4,5; Ro 2:4 Ro 11:20-22 he. 5:13; Ec 9:11; Isa 5:21; Mt 11:25,26; Lu 10:21; 1Co 1:26; 3:19</p>"}]}