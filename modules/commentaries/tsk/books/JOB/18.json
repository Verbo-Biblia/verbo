{"entries":[{"id":"tsk-job-18-1","title":"Job 18:1","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":1,"chapterEnd":18,"verseEnd":1},"content":"<p>1 Bildad reproves Job for presumption and impatience. 5 The calamities of the wicked.</p>\n<p>Bildad. 2:11; 8:1; 25:1; 42:7-9</p>"},{"id":"tsk-job-18-2","title":"Job 18:2","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":2,"chapterEnd":18,"verseEnd":2},"content":"<p>How long. 8:2; 11:2; 13:5,6; 16:2,3 mark. 3:5,6,17; 21:2; 33:1; Pr 18:13; Jas 1:19</p>"},{"id":"tsk-job-18-3","title":"Job 18:3","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":3,"chapterEnd":18,"verseEnd":3},"content":"<p>Wherefore. 12:7,8; 17:4,10; Ps 73:22; Ec 3:18; Ro 12:10</p>"},{"id":"tsk-job-18-4","title":"Job 18:4","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":4,"chapterEnd":18,"verseEnd":4},"content":"<p>teareth. 5:2; 13:14; 16:9; Jon 4:9; Mr 9:18; Lu 9:39 himself. Heb. his soul. shall the. 40:8; Eze 9:9 the rock. 14:18; Isa 54:10; Mt 24:35</p>"},{"id":"tsk-job-18-5","title":"Job 18:5","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":5,"chapterEnd":18,"verseEnd":5},"content":"<p>the light. 20:5; Pr 4:19; 13:9; 20:20; 24:20 spark. Isa 50:11</p>"},{"id":"tsk-job-18-6","title":"Job 18:6","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":6,"chapterEnd":18,"verseEnd":6},"content":"<p>candle. or, lamp. 21:17; Ps 18:28; Re 18:23</p>"},{"id":"tsk-job-18-7","title":"Job 18:7","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":7,"chapterEnd":18,"verseEnd":7},"content":"<p>steps. 20:22; 36:16; Ps 18:36; Pr 4:12 his own. 5:12,13; 2Sa 15:31; 17:14; Ps 33:10; Pr 1:30-32; Ho 10:6; 1Co 3:19</p>"},{"id":"tsk-job-18-8","title":"Job 18:8","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":8,"chapterEnd":18,"verseEnd":8},"content":"<p>he is cast. 22:10; Es 3:9; 6:13; 7:5,10; Ps 9:15; 35:8; Pr 5:22; 29:6; Eze 32:3 1Ti 3:7; 6:9; 2Ti 2:26</p>"},{"id":"tsk-job-18-9","title":"Job 18:9","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":9,"chapterEnd":18,"verseEnd":9},"content":"<p>The gin. Isa 8:14,15 robber. 1:15,17; 5:5</p>"},{"id":"tsk-job-18-10","title":"Job 18:10","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":10,"chapterEnd":18,"verseEnd":10},"content":"<p>snare. Ps 11:6; Eze 12:13; Ro 11:9 laid. Heb. hidden.</p>"},{"id":"tsk-job-18-11","title":"Job 18:11","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":11,"chapterEnd":18,"verseEnd":11},"content":"<p>Terrors. 6:4; 15:21; 20:25; Ps 73:19; Jer 6:25; 20:3,4; 46:5; 49:29; 2Co 5:11 Re 6:15,16 drive him. Heb. scatter him. to his feet. Le 26:36; 2Ki 7:6,7; Ps 53:5; Pr 28:1</p>"},{"id":"tsk-job-18-12","title":"Job 18:12","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":12,"chapterEnd":18,"verseEnd":12},"content":"<p>hunger-bitten. 15:23,24; 1Sa 2:5,36; Ps 34:10; 109:10 destruction. Ps 7:12-14; 1Th 5:3; 2Pe 2:3</p>"},{"id":"tsk-job-18-13","title":"Job 18:13","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":13,"chapterEnd":18,"verseEnd":13},"content":"<p>strength. Heb. bars. 17:16; Jon 2:6 the firstborn. Ge 49:3; Isa 14:30; Re 6:8</p>"},{"id":"tsk-job-18-14","title":"Job 18:14","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":14,"chapterEnd":18,"verseEnd":14},"content":"<p>confidence. 8:14; 11:20; Ps 112:10; Pr 10:28; Mt 7:26,27 the king. 24:17; 41:34; Ps 55:4; Pr 14:32; 1Co 15:55,56; Heb 2:15</p>"},{"id":"tsk-job-18-15","title":"Job 18:15","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":15,"chapterEnd":18,"verseEnd":15},"content":"<p>dwell. 12,13; Zec 5:4 because. 20:18-21; 31:38,39; Jer 22:13; Hab 2:6-11 brimstone. Ge 19:24; De 29:23; Ps 11:6; Isa 34:9,10; Re 19:20; 21:8</p>"},{"id":"tsk-job-18-16","title":"Job 18:16","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":16,"chapterEnd":18,"verseEnd":16},"content":"<p>roots. 29:19; Isa 5:24; Ho 9:16; Am 2:9; Mal 4:1 shall his branch. 5:3,4; 15:30</p>"},{"id":"tsk-job-18-17","title":"Job 18:17","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":17,"chapterEnd":18,"verseEnd":17},"content":"<p>13:12; Ps 34:16; 83:4; 109:13; Pr 2:22; 10:7</p>"},{"id":"tsk-job-18-18","title":"Job 18:18","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":18,"chapterEnd":18,"verseEnd":18},"content":"<p>He shall be driven. Heb. They shall drive him. 3:20; 10:22; 11:14; Isa 8:21,22; Jude 1:13 chased. 20:8; Pr 14:32; Isa 17:13,14; Da 4:33; 5:21</p>"},{"id":"tsk-job-18-19","title":"Job 18:19","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":19,"chapterEnd":18,"verseEnd":19},"content":"<p>neither. 1:19; 8:4; 42:13-16; Ps 109:13; Isa 14:21,22; Jer 22:30 nor any. 20:26-28; Isa 5:8,9</p>"},{"id":"tsk-job-18-20","title":"Job 18:20","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":20,"chapterEnd":18,"verseEnd":20},"content":"<p>astonied. De 29:23,24; 1Ki 9:8; Jer 18:16 his day. Ps 37:13; 137:7; Eze 21:25; Ob 1:11-15; Lu 19:42,44 went. or, lived with him. were affrighted. Heb. laid holdon horror. 2:12,13; 19:13-19</p>"},{"id":"tsk-job-18-21","title":"Job 18:21","author":"R. A. Torrey (editor)","reference":{"book":"JOB","chapterStart":18,"verseStart":21,"chapterEnd":18,"verseEnd":21},"content":"<p>such are. 14-16 knoweth. 21:14; Ex 5:2; Jud 2:10; 1Sa 2:12; 1Ch 28:9; Ps 79:6; Jer 9:3; 10:25 Ro 1:28; 1Th 4:5; 2Th 1:8; Tit 1:16</p>"}]}