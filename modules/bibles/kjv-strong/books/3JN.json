morph":"robinson:P-GPF"},{"text":"receiveth","strong":"G1926","morph":"robinson:V-PNI-3S"},{"text":"us","strong":"G1473","morph":"robinson:P-1AP"},{"text":"not.","strong":"G3756","morph":"robinson:PRT-N"}],"strongs":["G235","G846","G1125","G1361","G1473","G1577","G1926","G3588","G3756","G5383"]},"10":{"text":"Wherefore, if I come, I will remember his deeds which he doeth, prating against us with malicious words: and not content therewith, neither doth he himself receive the brethren, and forbiddeth them that would, and casteth them out of the church.","segments":[{"text":"Wherefore,","strong":"G3778","morph":"robinson:D-ASN"},{"text":"if","strong":"G1437","morph":"robinson:COND"},{"text":"I come,","strong":"G2064","morph":"robinson:V-2AAS-1S"},{"text":"I will remember","strong":"G5279","morph":"robinson:V-FAI-1S"},{"text":"his","strong":"G846","morph":"robinson:P-GSM"},{"text":"deeds","strongs":["G3588","G2041"],"morphs":["robinson:T-APN","robinson:N-APN"]},{"text":"which","strong":"G3739","morph":"robinson:R-APN"},{"text":"he doeth,","strong":"G4160","morph":"robinson:V-PAI-3S"},{"text":"prating against","strong":"G5396","morph":"robinson:V-PAP-NSM"},{"text":"us","strong":"G1473","morph":"robinson:P-1AP"},{"text":"with","strong":"G3056","morph":"robinson:N-DPM"},{"text":"malicious","strong":"G4190","morph":"robinson:A-DPM"},{"text":"words:","strong":"G3056","morph":"robinson:N-DPM"},{"text":"and","strong":"G2532","morph":"robinson:CONJ"},{"text":"not","strong":"G3361","morph":"robinson:PRT-N"},{"text":"content","strong":"G714","morph":"robinson:V-PPP-NSM"},{"text":"therewith,","strong":"G3778","morph":"robinson:D-DPM"},{"text":"neither","strong":"G3777","morph":"robinson:CONJ-N"},{"text":"doth","strong":"G1926","morph":"robinson:V-PNI-3S"},{"text":"he himself","strong":"G846","morph":"robinson:P-NSM"},{"text":"receive","strong":"G1926","morph":"robinson:V-PNI-3S"},{"text":"the brethren,","strongs":["G3588","G80"],"morphs":["robinson:T-APM","robinson:N-APM"]},{"text":"and","strong":"G2532","morph":"robinson:CONJ"},{"text":"forbiddeth","strong":"G2967","morph":"robinson:V-PAI-3S"},{"text":"them that would,","strong":"G1014","morph":"robinson:V-PNP-APM"},{"text":"and","strong":"G2532","morph":"robinson:CONJ"},{"text":"casteth","strong":"G1544","morph":"robinson:V-PAI-3S"},{"text":"them"},{"text":"out of","strong":"G1537","morph":"robinson:PREP"},{"text":"the church.","strongs":["G3588","G1577"],"morphs":["robinson:T-GSF","robinson:N-GSF"]}],"strongs":["G80","G714","G846","G1014","G1437","G1473","G1537","G1544","G1577","G1926","G2041","G2064","G2532","G2967","G3056","G3361","G3588","G3739","G3777","G3778","G4160","G4190","G5279","G5396"]},"11":{"text":"Beloved, follow not that which is evil, but that which is good. He that doeth good is of God: but he that doeth evil hath not seen God.","segments":[{"text":"Beloved,","strong":"G27","morph":"robinson:A-VSM"},{"text":"follow","strong":"G3401","morph":"robinson:V-PNM-2S"},{"text":"not","strong":"G3361","morph":"robinson:PRT-N"},{"text":"that which is","strong":"G3588","morph":"robinson:T-ASN"},{"text":"evil,","strong":"G2556","morph":"robinson:A-ASN"},{"text":"but","strong":"G235","morph":"robinson:CONJ"},{"text":"that which is","strong":"G3588","morph":"robinson:T-ASN"},{"text":"good.","strong":"G18","morph":"robinson:A-ASN"},{"text":"He","strong":"G3588","morph":"robinson:T-NSM"},{"text":"that doeth good","strong":"G15","morph":"robinson:V-PAP-NSM"},{"text":"is","strong":"G1510","morph":"robinson:V-PAI-3S"},{"text":"of","strong":"G1537","morph":"robinson:PREP"},{"text":"God:","strongs":["G3588","G2316"],"morphs":["robinson:T-GSM","robinson:N-GSM"]},{"text":"but","strong":"G1161","morph":"robinson:CONJ"},{"text":"he","strong":"G3588","morph":"robinson:T-NSM"},{"text":"that doeth evil","strong":"G2554","morph":"robinson:V-PAP-NSM"},{"text":"hath","strong":"G3708","morph":"robinson:V-RAI-3S-ATT"},{"text":"not","strong":"G3756","morph":"robinson:PRT-N"},{"text":"seen","strong":"G3708","morph":"robinson:V-RAI-3S-ATT"},{"text":"God.","strongs":["G3588","G2316"],"morphs":["robinson:T-ASM","robinson:N-ASM"]}],"strongs":["G15","G18","G27","G235","G1161","G1510","G1537","G2316","G2554","G2556","G3361","G3401","G3588","G3708","G3756"]},"12":{"text":"Demetrius hath good report of all men, and of the truth itself: yea, and we also bear record; and ye know that our record is true.","segments":[{"text":"Demetrius","strong":"G1216","morph":"robinson:N-DSM"},{"text":"hath good report","strong":"G3140","morph":"robinson:V-RPI-3S"},{"text":"of","strong":"G5259","morph":"robinson:PREP"},{"text":"all","strong":"G3956","morph":"robinson:A-GPM"},{"text":"men,"},{"text":"and","strong":"G2532","morph":"robinson:CONJ"},{"text":"of","strong":"G5259","morph":"robinson:PREP"},{"text":"the truth","strongs":["G3588","G225"],"morphs":["robinson:T-GSF","robinson:N-GSF"]},{"text":"itself:","strong":"G846","morph":"robinson:P-GSF"},{"text":"yea,","strong":"G1161","morph":"robinson:CONJ"},{"text":"and","strong":"G2532","morph":"robinson:CONJ"},{"text":"we","strong":"G1473","morph":"robinson:P-1NP"},{"text":"also"},{"text":"bear record;","strong":"G3140","morph":"robinson:V-PAI-1P"},{"text":"and","strong":"G2532","morph":"robinson:CONJ"},{"text":"ye know","strong":"G1492","morph":"robinson:V-RAI-2P"},{"text":"that","strong":"G3754","morph":"robinson:CONJ"},{"text":"our","strong":"G1473","morph":"robinson:P-1GP"},{"text":"record","strongs":["G3588","G3141"],"morphs":["robinson:T-NSF","robinson:N-NSF"]},{"text":"is","strong":"G1510","morph":"robinson:V-PAI-3S"},{"text":"true.","strong":"G227","morph":"robinson:A-NSF"}],"strongs":["G225","G227","G846","G1161","G1216","G1473","G1492","G1510","G2532","G3140","G3141","G3588","G3754","G3956","G5259"]},"13":{"text":"I had many things to write, but I will not with ink and pen write unto thee:","segments":[{"text":"I had","strong":"G2192","morph":"robinson:V-IAI-1S"},{"text":"many things","strong":"G4183","morph":"robinson:A-APN"},{"text